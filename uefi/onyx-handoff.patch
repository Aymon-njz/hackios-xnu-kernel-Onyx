diff --git a/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.c b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.c
new file mode 100644
index 0000000..4ec1d42
--- /dev/null
+++ b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.c
@@ -0,0 +1,66 @@
+/**
+  XNU payload handoff.
+
+  The boot shim places an appended XNUP container in reserved RAM. This
+  library starts its loader.efi entry without reading or writing Android
+  partitions; a failed handoff simply cold-resets the device.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+
+#include <Library/BaseLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+#include "XnuLoader.h"
+
+STATIC
+VOID
+StartPayloadLoader (
+  VOID
+  )
+{
+  XNU_PAYLOAD_HEADER *Header = (XNU_PAYLOAD_HEADER *)XNU_PAYLOAD_BASE;
+  UINT8              *Cursor;
+  UINT8              *End;
+
+  if (Header->Magic != XNU_PAYLOAD_MAGIC || Header->Size > XNU_PAYLOAD_MAX_SIZE) {
+    return;
+  }
+
+  Cursor = (UINT8 *)(Header + 1);
+  End    = Cursor + Header->Size;
+
+  while (Cursor + sizeof (XNU_PAYLOAD_ENTRY) <= End) {
+    XNU_PAYLOAD_ENTRY *Entry = (XNU_PAYLOAD_ENTRY *)Cursor;
+    EFI_HANDLE         Handle;
+
+    if (Entry->Name[0] == 0) {
+      return;
+    }
+
+    if (Entry->Size > (UINTN)(End - (UINT8 *)(Entry + 1))) {
+      return;
+    }
+
+    if (AsciiStrnCmp (Entry->Name, "loader.efi", sizeof (Entry->Name)) == 0) {
+      if (!EFI_ERROR (gBS->LoadImage (FALSE, gImageHandle, NULL, Entry + 1, Entry->Size, &Handle))) {
+        gBS->StartImage (Handle, NULL, NULL);
+      }
+      return;
+    }
+
+    Cursor += sizeof (XNU_PAYLOAD_ENTRY) + ALIGN_VALUE (Entry->Size, 16);
+  }
+}
+
+VOID
+XnuLoaderMain (
+  VOID
+  )
+{
+  StartPayloadLoader ();
+  gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+}
diff --git a/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.h b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.h
new file mode 100644
index 0000000..2eeffbb
--- /dev/null
+++ b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.h
@@ -0,0 +1,30 @@
+#ifndef _XNU_LOADER_H_
+#define _XNU_LOADER_H_
+
+//
+// The boot shim copies everything appended after the UEFI FD to this address.
+// The region is marked reserved in the device memory map.
+//
+#ifndef XNU_PAYLOAD_BASE
+#define XNU_PAYLOAD_BASE      0xA8000000ULL
+#endif
+#define XNU_PAYLOAD_MAX_SIZE  0x04000000ULL
+#define XNU_PAYLOAD_MAGIC     0x50554E58 // "XNUP"
+
+typedef struct {
+  UINT32 Magic;
+  UINT32 Size;
+} XNU_PAYLOAD_HEADER;
+
+// The header is followed by entries; an empty name ends the list.
+typedef struct {
+  CHAR8  Name[16];
+  UINT32 Size;
+  UINT32 Reserved;
+  // UINT8 Data[Size], padded to 16 bytes
+} XNU_PAYLOAD_ENTRY;
+
+VOID
+XnuLoaderMain ();
+
+#endif /* _XNU_LOADER_H_ */

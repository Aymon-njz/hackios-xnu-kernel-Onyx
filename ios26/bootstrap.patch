index 0000000..f4a6413
--- /dev/null
+++ b/onyx-tests/gic-driver-test.c
@@ -0,0 +1,25 @@
+#define ONYX_GIC_HOST_TEST 1
+#include "onyx_gic_v3.c"
+static void reset(void){
+ memset(dist,0,sizeof dist);memset(redist,0,sizeof redist);memset(gicr_cpu_base,0,sizeof gicr_cpu_base);
+ gicd_base=gicr_base=gicr_size=0;cpu=maps=ticks=interrupts=signals=eois=next_irq=0;handler=NULL;expect_panic=0;
+ prop_bytes=32;reg_values[0]=0x16d00000;reg_values[1]=0x10000;reg_values[2]=0x16d80000;reg_values[3]=0x100000;
+ redist[GICR_TYPER/8]=GICR_TYPER_LAST;
+}
+int main(void){
+ reset();gic_v3_irq_cpu_init();assert(maps==2 && handler);
+ assert(*(uint32_t*)((char*)redist+GICR_IGROUPR0)&(1u<<27));
+ assert(*(uint32_t*)((char*)redist+GICR_ISENABLER0)&(1u<<27));
+ assert((dist[0]&0x12)==0x12);
+ irqs[0]=27;irqs[1]=45;irqs[2]=1023;handler(0,0,0,0);
+ assert(interrupts==1 && eois==2 && cpu_data.cpu_decrementer==UINT32_MAX);
+ assert(*(uint32_t*)((char*)dist+GICD_ICENABLER(1))==(1u<<13));
+ reset();prop_bytes=24;expect_panic=1;if(!setjmp(fault)){gic_v3_irq_cpu_init();assert(0);}assert(maps==0);
+ reset();reg_values[1]=0;expect_panic=1;if(!setjmp(fault)){gic_v3_irq_cpu_init();assert(0);}assert(maps==0);
+ reset();reg_values[0]=UINT64_MAX;expect_panic=1;if(!setjmp(fault)){gic_v3_irq_cpu_init();assert(0);}assert(maps==0);
+ reset();cpu=1;expect_panic=1;if(!setjmp(fault)){gic_v3_irq_cpu_init();assert(0);}assert(maps==0);
+ reset();*(uint32_t*)((char*)redist+GICR_WAKER)=GICR_WAKER_CHILDASLEEP;expect_panic=1;
+ if(!setjmp(fault)){gic_v3_irq_cpu_init();assert(0);}assert(strstr(panic_message,"timeout") && ticks<12000);
+ reset();dist[0]=GICD_CTLR_RWP;expect_panic=1;if(!setjmp(fault)){gic_v3_irq_cpu_init();assert(0);}assert(strstr(panic_message,"timeout") && ticks<12000);
+ puts("GIC adapter: timer routing/EOI, unknown SPI masking, DT bounds, single-CPU gate, wake and RWP timeouts passed");
+}

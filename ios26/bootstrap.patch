+#define getCpuDatap() (&cpu_data)
+static void rtclock_intr(unsigned x){assert(x==1); interrupts++;}
+static void cpu_signal_handler(void){signals++;}
+static int ml_set_interrupts_enabled(int x){(void)x;return 0;}
+static int SecureDTLookupEntry(void *p,const char *s,DTEntry *out){(void)p;assert(!strcmp(s,"/arm-io/gic"));*out=(void*)1;return 0;}
+#define kSuccess 0
+static int SecureDTGetProperty(DTEntry p,const char *n,const void **out,unsigned *len){(void)p;assert(!strcmp(n,"reg"));*out=reg_values;*len=prop_bytes;return 0;}
+static uint64_t pe_arm_get_soc_base_phys(void){return 0x400000;}
+static vm_offset_t ml_io_map(vm_offset_t p,vm_size_t n){maps++;if(p==0x17100000){assert(n==0x10000);return (uintptr_t)dist;}assert(p==0x17180000 && n==0x100000);return (uintptr_t)redist;}
+static void ml_install_interrupt_handler(void *n,int s,void *t,void (*f)(void*,void*,void*,int),void *r){(void)n;(void)s;(void)t;(void)r;handler=f;}
+static uint64_t rsr(const char *r){if(!strcmp(r,"MPIDR_EL1"))return 0x80000000;if(!strcmp(r,"CNTFRQ_EL0"))return 1000000;if(!strcmp(r,"CNTVCT_EL0"))return ticks+=100;if(!strcmp(r,"ICC_IAR1_EL1"))return irqs[next_irq++];return 0;}
+static void wsr(const char *r,uint64_t v){(void)v;if(!strcmp(r,"ICC_EOIR1_EL1"))eois++;}

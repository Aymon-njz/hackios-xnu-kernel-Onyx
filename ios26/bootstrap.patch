+static __attribute__((noreturn)) void test_panic(const char *fmt,...) {panic_message=fmt;assert(expect_panic);longjmp(fault,1);}
+#define panic(...) test_panic(__VA_ARGS__)
+static int cpu_number(void){return (int)cpu;}

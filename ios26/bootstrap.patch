diff --git a/bsd/dev/hakios.onyx_journal.h b/bsd/dev/hakios.onyx_journal.h
new file mode 100644
index 0000000..8f8d619
--- /dev/null
+++ b/bsd/dev/hakios.onyx_journal.h
@@ -0,0 +1,57 @@
+#ifndef HAKIOS_ONYX_JOURNAL_H
+#define HAKIOS_ONYX_JOURNAL_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#define ONYX_JOURNAL_BYTES (2u << 20)
+#define ONYX_JOURNAL_HEADER 4096u
+#define ONYX_USERDATA_BYTES 249517027328ULL
+#define ONYX_USERDATA_START_LBA 3124736ULL
+#define ONYX_JOURNAL_FIRST_LBA 64041467ULL
+
+static inline bool
+onyx_journal_geometry(uint32_t block_size, uint64_t blocks, uint64_t start,
+    uint16_t unit, uint8_t firmware_lun, uint8_t native_lun, uint64_t native_offset)
+{
+	/* Old UEFI device paths can leave LUN unknown (0xff). The native
+	 * mapping must still be unit/LUN 0, with the pinned address and size;
+	 * a matching journal signature is also read from LUN 0 before writes. */
+	return block_size == 4096 && blocks == ONYX_USERDATA_BYTES / 4096 &&
+	    start == ONYX_USERDATA_START_LBA && unit == 0 && native_lun == 0 &&
+	    (firmware_lun == 0 || firmware_lun == 0xff) && native_offset == start * 4096;
+}
+
+static inline bool
+onyx_journal_span(uint64_t first, uint64_t lba, uint64_t blocks)
+{
+	return first == ONYX_JOURNAL_FIRST_LBA && lba >= first && lba - first < 512u &&
+	    blocks > 0 && blocks <= 512u - (lba - first);
+}
+
+/* A slot may carry exactly its caller's validated journal WRITE(10), with
+ * Force Unit Access and no other control flags. Normal slots remain read-only. */
+static inline bool
+onyx_journal_command(const uint8_t *u, uint32_t dw0, uint32_t lba, uint32_t blocks, unsigned tag)
+{
+	if (!u || !blocks || blocks > 512 || dw0 != 0x12000000u ||
+	    u[0] != 1 || u[1] != 0x20 || u[2] != 0 || u[3] != tag ||
+	    u[16] != 0x2a || u[17] != 8) return false;
+	for (unsigned n = 4; n < 12; n++) if (u[n]) return false;
+	for (unsigned n = 25; n < 32; n++) if (u[n]) return false;
+	if (u[22]) return false;
+	uint32_t length = (uint32_t)u[12] << 24 | (uint32_t)u[13] << 16 | (uint32_t)u[14] << 8 | u[15];
+	uint32_t at = (uint32_t)u[18] << 24 | (uint32_t)u[19] << 16 | (uint32_t)u[20] << 8 | u[21];
+	return length == blocks * 4096u && at == lba && (((uint32_t)u[23] << 8) | u[24]) == blocks;
+}
+
+static inline uint32_t
+onyx_journal_crc(const uint8_t *bytes, size_t length)
+{
+	uint32_t crc = UINT32_MAX;
+	for (size_t n = 0; n < length; n++) {
+		crc ^= bytes[n];
+		for (unsigned bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ ((0u - (crc & 1)) & 0xedb88320u);
+	}
+	return ~crc;
+}
+#endif
diff --git a/bsd/dev/hakios.ufshc.h b/bsd/dev/hakios.ufshc.h
new file mode 100644
index 0000000..b24f79f
--- /dev/null
+++ b/bsd/dev/hakios.ufshc.h
@@ -0,0 +1,34 @@
+/*
+ * The kernel's own UFS driver (hakios.ufshc.c), as hakios.ufs.c uses it.
+ */
+#ifndef _HAKIOS_UFSHC_H_
+#define _HAKIOS_UFSHC_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* what the loader's page says about it (struct loader_block's native sections) */
+struct ufshc_loader {
+	uint64_t hc_pa;                         /* the controller's registers; 0: not offered */
+	uint64_t area_pa;                       /* the loader's memory for this kernel's list and command descriptors */
+	uint32_t area_size, ucd_offset, ucd_size, slots;
+	uint32_t uefi_lo, uefi_hi;              /* UEFI's list */
+	volatile uint32_t *take_back;           /* the loader's: it takes the controller back, send nothing more */
+	volatile uint32_t *list_in;             /* this kernel's: its list is in */
+	uint32_t *switched_in, *switched_out;
+	volatile uint32_t *cnr_at_switch;       /* this kernel's: UTRLCNR when its list went in */
+};
+
+bool ufshc_probe(const struct ufshc_loader *loader, bool only);
+bool ufshc_available(void);
+void ufshc_set_luns(uint32_t mask);
+int ufshc_switch_in(bool prove);
+int ufshc_switch_out(const char *why);
+bool ufshc_list_in(void);
+int ufshc_read(uint8_t lun, uint64_t offset, uint8_t *dst, uint64_t len);
+/* Internal diagnostic writer; not a general writable block interface. */
+int ufshc_journal_write(uint64_t first, uint64_t lba, const uint8_t *src, uint32_t bytes);
+void ufshc_report(const char *when);
+void hakios_ufs_quiesce(void);
+
+#endif
diff --git a/bsd/dev/onyx_storage_init.c b/bsd/dev/onyx_storage_init.c
new file mode 100644
index 0000000..bc5c8f5
--- /dev/null
+++ b/bsd/dev/onyx_storage_init.c
@@ -0,0 +1,39 @@
+/* First native Onyx storage integration; no controller access without opt-in. */
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <pexpert/pexpert.h>
+#include "hakios.ufshc.h"
+SYSCTL_NODE(_kern, OID_AUTO, hakios, CTLFLAG_RW | CTLFLAG_LOCKED, 0,
+    "Onyx development storage diagnostics");
+extern void hakios_ufs_init(void);
+void onyx_storage_init(void)
+{
+    int enabled=0, cpus=0, native=0, value=0;
+    if (!PE_parse_boot_argn("onyx_ufs_probe", &enabled, sizeof enabled) || enabled != 1) {
+        printf("onyx26-ufs: transport compiled; opt-in probe disabled\n");
+        return;
+    }
+    if (!PE_parse_boot_argn("cpus", &cpus, sizeof cpus) || cpus != 1 ||
+        !PE_parse_boot_argn("ufs_native", &native, sizeof native) || native != 4) {
+        printf("onyx26-ufs: probe refused: requires cpus=1 ufs_native=4\n");
+        return;
+    }
+    const char *refused[] = {"ufs_write", "ufs_native_hang", "ufs_native_leave",
+        "ufs_native_check", "ufs_bench", "ufs_check", "ufs_return"};
+    for (unsigned n=0; n<sizeof refused/sizeof refused[0]; n++) {
+        value=0;
+        if (PE_parse_boot_argn(refused[n], &value, sizeof value) && value) {
+            printf("onyx26-ufs: unsupported bring-up option %s\n", refused[n]);
+            return;
+        }
+    }
+    printf("onyx26-ufs: initialize native loader-page/block bridge\n");
+    hakios_ufs_init();
+}
+/* Legacy diagnostic options call this. There is no proven return path in the
+ * new kernel; quiesce our list before stopping, rather than jump into old code. */
+void loader_return(void)
+{
+    hakios_ufs_quiesce();
+    panic("onyx26: legacy loader-return path unavailable");
+}
diff --git a/bsd/dev/onyx_ufs.c b/bsd/dev/onyx_ufs.c
new file mode 100644
index 0000000..f3afe49
--- /dev/null
+++ b/bsd/dev/onyx_ufs.c
@@ -0,0 +1,1998 @@
+/*
+ * The phone's storage: one block device and one character device for every GPT partition of its
+ * UFS (/dev/ufs_NAME and /dev/rufs_NAME, NAME as the partition table has it).
+ * These devices remain read only except for the data-volume option below.
+ * onyx_log_native=1 separately opts into an internal diagnostic snapshot writer
+ * confined to the pre-existing, pinned final 2 MiB journal of Onyx userdata.
+ *
+ * There is no UFS driver here, and none is needed. UEFI never exits on this port: Qualcomm's own
+ * UFS driver (UFSDxe) has brought up the controller, its PHY, its clocks and power, and stays
+ * resident, and xnuloader keeps serving the kernel from core 0 while the kernel runs on another
+ * core (it already does for the battery). So with ufs=2 on its command line the loader publishes a
+ * page (ufs_shared_pa=) with the table of partitions, a request and an answer, and a buffer; this
+ * driver writes a request -- which partition, which blocks -- and core 0 reads them with that
+ * driver's ReadBlocks into the buffer (xnuloader/loader.c, block_poll). Nothing in this kernel
+ * touches the storage controller.
+ *
+ * Read only wherever a write could do harm, by construction. The block devices never write: the
+ * strategy routine refuses, so no filesystem mounted from one can write, and opening one for
+ * writing is refused. With ufs_write=1 one character device alone takes writes -- /dev/rufs_darwin,
+ * the port's own partition -- and in it only whole blocks from UFS_WRITE_FIRST on, past the Darwin
+ * volume and both cryptexes that the build writes from the computer (tools/darwin-write.py); that
+ * is where the data volume of Darwin is kept between runs (userland/src/var_store.c). The partition
+ * has to be the one the port was set up with (its name, size, place and logical unit here; its
+ * GUIDs as well on the loader's side), and the loader refuses the same things over again and reads
+ * every write back before it answers. Without ufs_write=1 nothing writes at all.
+ *
+ * One request at a time (the page has one), so requests are serialized by a mutex and split into
+ * pieces of the buffer's size. The kernel writes only the request's cache lines and core 0 only
+ * the answer's (see the loader), both through a mapping that does not cache here, so neither side
+ * ever overwrites the other's. The data buffer, which only core 0's reads fill, is mapped cacheable
+ * and the part of it an answer covers is invalidated here before it is copied out.
+ *
+ * The data volume of Darwin (HFS Plus, built into this kernel: bsd/hfs) is /dev/ufs_darwin_data: darwin from
+ * UFS_WRITE_FIRST to its end, a block device of its own that reads and writes, there with ufs_write=1 only. Its
+ * writes go the same way as /dev/rufs_darwin's -- through the loader, which flushes and reads every one back before it
+ * answers -- so a write that has come back is on the flash, which is what the file system's journal counts on. The
+ * one and the other are not used in the same run: once the data volume has been opened for writing, the packed store
+ * (var_store) is refused, and while a saver holds the store the data volume does not open for writing.
+ *
+ * ufs_check=1 reads, once at start, the partitions there are images of in the ROM's
+ * firmware-update/ (bluetooth, xbl, tz, ...) through the same path and prints an FNV-1a hash of
+ * as many bytes as each image has: tools/ufs-survey.py compares those with the images and with
+ * what the loader read itself before the kernel started.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <sys/uio.h>
+
+#include <libkern/crc.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern_xnu.h>
+#include <arm/machine_routines.h>
+#include <arm/caches_internal.h>
+#include "hakios.ufshc.h"
+#include "hakios.onyx_journal.h"
+
+extern void IOSleep(unsigned int milliseconds);
+extern void loader_return(void);        /* osfmk/arm64/loader_return.c */
+
+/* the page the loader publishes: the same layout as struct loader_block in xnuloader/loader.c */
+#define BLOCK_MAGIC        0x4b434f4c42574452ULL       /* "RDWBLOCK" */
+#define BLOCK_VERSION      3
+#define BLOCK_MAX_PARTS    160
+#define BLOCK_MAX_UNITS    16
+#define BLOCK_PART_UNIT    1u                          /* a whole logical unit, not a partition */
+#define BLOCK_OP_READ      0u
+#define BLOCK_OP_WRITE     1u
+#define BLOCK_OP_WRITE_FAST 2u                         /* written only: the data volume's (the loader, BLOCK_OP_WRITE_FAST) */
+#define BLOCK_OP_FLUSH     3u
+#define BLOCK_CAN_FAST     1u
+
+/*
+ * Where a write may go, and nowhere else: darwin, the port's own 20 GiB at the end of logical
+ * unit 0, and in it only past what the build puts there from the computer -- the Darwin volume
+ * (blocks 0..1374207) and the two cryptexes behind it (..2042367). The loader keeps the same
+ * bounds and checks the partition's type besides (xnuloader/loader.c, BLOCK_WRITE_FIRST). Where darwin
+ * begins and its exact size are the phone's (tools/userdata-carve.py puts it after userdata, whatever
+ * that is): at least the layout's 20 GiB.
+ */
+#define UFS_WRITE_FIRST    2042368ULL                  /* darwin's blocks of 4096 */
+#define UFS_DARWIN_MIN     5242875ULL                  /* the first phone's darwin, in blocks of 4096 */
+
+struct loader_block_part {
+	char name[36];
+	uint32_t block_size;
+	uint64_t blocks;
+	uint64_t start_lba;            /* where it begins on its unit, in the unit's blocks */
+	uint16_t unit;                 /* the unit it is on, its number among the units; 0xffff: not known */
+	uint8_t lun;                   /* a unit's logical unit number as its device path says; 0xff: it does not */
+	uint8_t flags;                 /* BLOCK_PART_UNIT */
+	uint32_t reserved;
+};
+
+struct loader_block {
+	uint64_t magic;
+	uint32_t version, size;
+	uint32_t parts, buffer_size;
+	uint64_t buffer_pa;
+	/*
+	 * Which partition the loader will take writes for this run (its index plus one; 0: none) and
+	 * from which of its blocks. They sit in what was padding, so the page is the size and the
+	 * version it was and one phone goes on being shared: a loader built before writes existed
+	 * leaves them zero, which is no write, and a kernel built before them leaves ask.op zero,
+	 * which is a read.
+	 */
+	uint32_t write_part_plus_one;
+	uint32_t write_caps;                   /* BLOCK_CAN_FAST; zero from a loader that has only BLOCK_OP_WRITE */
+	uint64_t write_first;
+	struct {
+		volatile uint32_t request;
+		uint32_t part;
+		uint64_t lba, count;
+		uint32_t op;                   /* BLOCK_OP_READ, BLOCK_OP_WRITE */
+		uint32_t reserved;
+	} ask __attribute__((aligned(128)));
+	struct {
+		volatile uint32_t answered;
+		uint32_t reserved;
+		int64_t status;
+		uint64_t served, failed, bytes, ticks;
+	} answer __attribute__((aligned(128)));
+	struct loader_block_part part[BLOCK_MAX_PARTS] __attribute__((aligned(128)));
+	/* the loader's offer of an area for this kernel's own transfer request list, and UEFI's list */
+	struct {
+		uint64_t hc_pa;
+		uint64_t area_pa;
+		uint32_t area_size, ucd_offset, ucd_size, slots;
+		uint32_t uefi_utrlba, uefi_utrlbau;
+	} native __attribute__((aligned(128)));
+	struct {
+		volatile uint32_t take_back;   /* the loader's: it takes the controller back, send nothing more */
+	} loader_native __attribute__((aligned(128)));
+	struct {
+		volatile uint32_t list_in;     /* this kernel's: its list is in */
+		uint32_t switched_in, switched_out;
+		volatile uint32_t cnr_at_switch;       /* UTRLCNR when its list went in (for the loader's take-back) */
+	} kernel_native __attribute__((aligned(128)));
+};
+
+_Static_assert(__builtin_offsetof(struct loader_block, ask) == 128,
+    "the loader's page must stay the size it was: what is before ask has to fit in its padding");
+
+#define UFS_PAGE           0x4000UL
+#define UFS_TIMEOUT_MS     20000        /* core 0 answers in well under a second; this is for a dead loader */
+
+static volatile struct loader_block *ufs_page;
+static uint8_t *ufs_buffer;             /* the loader's data buffer: filled by it for a read, here for a write */
+static uint32_t ufs_buffer_size, ufs_parts, ufs_seq;
+static uint32_t ufs_bsize[BLOCK_MAX_PARTS];   /* the block size each device is counted in (spec_open sets 512) */
+static int ufs_bmajor = -1, ufs_cmajor = -1;
+static bool ufs_ready, ufs_dead;
+static uint64_t ufs_requests, ufs_errors, ufs_bytes, ufs_wait_us;
+static uint64_t ufs_copy_us;                    /* copying out of the loader's buffer */
+static uint64_t ufs_small, ufs_medium, ufs_large; /* requests of <= 4 KB, <= 64 KB, more */
+static uint64_t ufs_sequential;                 /* requests that start where the one before ended */
+static uint32_t ufs_last_part = ~0u;
+static uint64_t ufs_last_end;
+
+/*
+ * This kernel's own UFS driver (hakios.ufshc.c), with ufs_native=1: each partition's logical
+ * unit and where it begins there, in bytes; reads go that way unless it fails, and then through
+ * the loader again. While its list is in the controller the loader is asked for nothing.
+ */
+static uint8_t ufs_lun[BLOCK_MAX_PARTS];         /* 0xff: not known, read through the loader */
+static uint64_t ufs_lun_offset[BLOCK_MAX_PARTS];
+static bool ufs_native_mapped;
+static uint32_t ufs_native_luns;                /* how many units are mapped (LUN 0..n-1) */
+static volatile bool ufs_native_on;
+static uint64_t ufs_native_fallbacks, ufs_mailbox_refused;
+static void ufs_journal_start(void);
+
+static LCK_GRP_DECLARE(ufs_lck_grp, "hakios-ufs");
+static LCK_MTX_DECLARE(ufs_lock, &ufs_lck_grp);
+/* One writer at a time; never held while the mailbox is, nor while user memory is touched. */
+static LCK_MTX_DECLARE(ufs_write_mtx, &ufs_lck_grp);
+
+/*
+ * Saving the data volume without being asked (userland/src/var_store.c).
+ *
+ * The volume is packed and written by a program, not by this kernel, so the kernel's part is to
+ * say when and to let only one program at a time do it:
+ *
+ *   kern.hakios.var_save   the handshake. The saver writes VAR_SAVE_IDLE when it starts and is
+ *                           then the one that will be asked; on the orderly way back to the loader
+ *                           (loader_return_after expired, or "xl stop") the kernel writes
+ *                           VAR_SAVE_WANTED and waits, and the saver writes VAR_SAVE_DONE when the
+ *                           volume is in the flash. Nobody registered: nothing is asked and
+ *                           nothing waited for, so a run without a saver returns as it always did.
+ *                           A panic does not come this way at all -- there is no program left to
+ *                           ask -- and then the store simply keeps what it had.
+ *   kern.hakios.var_busy   the claim. A write to /dev/rufs_darwin is refused unless the writer
+ *                           holds it, so two savers cannot interleave into one slot. It is held by
+ *                           process number, and a claimant may take it from a process that is gone
+ *                           (a saver killed in the middle leaves no lock behind for the rest of the
+ *                           run). What the one that was killed half-wrote is not lost either: the
+ *                           slot it was writing is not the one holding the newest good archive.
+ */
+#define VAR_SAVE_NONE      0
+#define VAR_SAVE_IDLE      1
+#define VAR_SAVE_WANTED    2
+#define VAR_SAVE_DONE      3
+#define VAR_SAVE_MS        20000        /* at most this long on the way out (var_save_ms=N) */
+
+static volatile int ufs_var_save = VAR_SAVE_NONE;
+static int ufs_var_busy_pid;
+
+/* ufs_write=1 and the one partition it is for: everything else answers EROFS as it always did */
+static int ufs_write_part = -1;
+static volatile bool ufs_write_busy;            /* a write of ours has this kernel's list out: not a failure */
+static bool ufs_write_out, ufs_write_was_native;        /* the list is out for writing, and was in before */
+static uint64_t ufs_writes, ufs_write_bytes, ufs_write_errors, ufs_write_refused;
+
+/* /dev/ufs_darwin_data: the minor number past every partition's, and the block size it is counted in */
+#define UFS_DATA_MINOR     BLOCK_MAX_PARTS
+static uint32_t ufs_data_bsize = 4096;
+static bool ufs_data_used;                      /* opened for writing this run: the packed store is not */
+static LCK_MTX_DECLARE(ufs_data_mtx, &ufs_lck_grp);     /* one write of the data volume at a time */
+
+SYSCTL_DECL(_kern_hakios);
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_requests, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_requests,
+    "requests the phone's storage has answered through the loader");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_errors, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_errors,
+    "requests the phone's storage has refused or not answered");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_bytes,
+    "bytes read from the phone's storage");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_wait_us, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_wait_us,
+    "microseconds spent waiting for core 0's answers");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_copy_us, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_copy_us,
+    "microseconds spent copying out of the loader's buffer");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_writes, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_writes,
+    "requests written into darwin and read back by the loader");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_write_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_write_bytes,
+    "bytes written into darwin");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_write_errors, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_write_errors,
+    "writes the loader refused or did not finish");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_write_refused, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_write_refused,
+    "writes refused here: not darwin, or not past what the build writes");
+
+/* The handshake: 1 to register as the saver, 3 to say the volume is in the flash. 2 is the kernel's. */
+static int
+ufs_sysctl_var_save(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = ufs_var_save, error;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, NULL);
+	if (error != 0 || req->newptr == 0) {
+		return error;
+	}
+	if (value == VAR_SAVE_IDLE && ufs_var_save != VAR_SAVE_WANTED) {
+		ufs_var_save = VAR_SAVE_IDLE;           /* a saver is there; it is the one that will be asked */
+	} else if (value == VAR_SAVE_DONE && ufs_var_save == VAR_SAVE_WANTED) {
+		ufs_var_save = VAR_SAVE_DONE;           /* and it has finished: the way out may go on */
+	} else if (value == VAR_SAVE_NONE) {
+		ufs_var_save = VAR_SAVE_NONE;
+	} else {
+		return EINVAL;
+	}
+	return 0;
+}
+
+SYSCTL_PROC(_kern_hakios, OID_AUTO, var_save, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    ufs_sysctl_var_save, "I", "the data volume's saver: 1 registers, 2 is the kernel asking, 3 is done");
+
+/* The claim on the store: 1 takes it, 0 gives it back; reading says which process holds it. */
+static int
+ufs_sysctl_var_busy(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = ufs_var_busy_pid, error, me = proc_selfpid();
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, NULL);
+	if (error != 0 || req->newptr == 0) {
+		return error;
+	}
+	lck_mtx_lock(&ufs_write_mtx);
+	if (value == 1 && ufs_data_used) {
+		error = EBUSY;          /* the data volume is mounted from darwin this run: no packed store into it */
+	} else if (value == 1) {
+		if (ufs_var_busy_pid != 0 && ufs_var_busy_pid != me) {
+			proc_t held = proc_find(ufs_var_busy_pid);
+
+			if (held != NULL) {
+				proc_rele(held);
+				lck_mtx_unlock(&ufs_write_mtx);
+				return EBUSY;   /* another saver has it and is alive: one at a time */
+			}
+			printf("var_store: the claim on the store was left by process %d, which is gone\n",
+			    ufs_var_busy_pid);
+		}
+		ufs_var_busy_pid = me;
+	} else if (value == 0) {
+		if (ufs_var_busy_pid == me || ufs_var_busy_pid == 0) {
+			ufs_var_busy_pid = 0;
+		} else {
+			error = EPERM;
+		}
+	} else {
+		error = EINVAL;
+	}
+	lck_mtx_unlock(&ufs_write_mtx);
+	return error;
+}
+
+SYSCTL_PROC(_kern_hakios, OID_AUTO, var_busy, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    ufs_sysctl_var_busy, "I", "the claim a writer of /dev/rufs_darwin must hold: 1 takes it, 0 gives it back");
+
+/*
+ * Native blocks [lba, lba + count) of partition part, one request of at most the buffer's size:
+ * read into dst, or, with src, written from there. Called with ufs_lock held.
+ */
+static int
+ufs_request(uint32_t op, uint32_t part, uint64_t lba, uint64_t count, uint8_t *dst, const uint8_t *src)
+{
+	uint64_t bytes = count * ufs_page->part[part].block_size, started, waited_ms = 0;
+	uint32_t seq = ++ufs_seq;
+	int64_t status;
+
+	if (ufs_dead) {
+		return EIO;
+	}
+	if (op == BLOCK_OP_READ) {
+		if (part == ufs_last_part && lba == ufs_last_end) {
+			ufs_sequential++;
+		}
+		ufs_last_part = part;
+		ufs_last_end = lba + count;
+	} else if (op != BLOCK_OP_FLUSH) {
+		/*
+		 * The data into the buffer and out of this core's cache before the request is raised:
+		 * core 0 drops its own lines of the buffer and hands it to UEFI's driver.
+		 */
+		memcpy(ufs_buffer, src, (size_t)bytes);
+		FlushPoC_DcacheRegion((vm_offset_t)ufs_buffer, (size_t)bytes);
+		ufs_last_part = ~0u;
+	}
+	ufs_page->ask.part = part;
+	ufs_page->ask.lba = lba;
+	ufs_page->ask.count = count;
+	ufs_page->ask.op = op;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	ufs_page->ask.request = seq;
+	__asm__ volatile ("dmb sy" ::: "memory");
+
+	started = mach_absolute_time();
+	while (ufs_page->answer.answered != seq) {
+		/* spin briefly for a quick answer, then sleep a millisecond at a time */
+		uint64_t us;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &us);
+		us /= 1000;
+		if (us < 2000) {
+			/* the answer to a small request comes in tens of microseconds: look often */
+			__builtin_arm_yield();
+			continue;
+		}
+		IOSleep(1);
+		if (++waited_ms > UFS_TIMEOUT_MS) {
+			/* no answer: the loader is gone or stuck; nothing more is asked of it */
+			printf("ufs: no answer from the loader to request %u in %u s: the storage is off from now on\n",
+			    seq, UFS_TIMEOUT_MS / 1000);
+			ufs_dead = true;
+			ufs_errors++;
+			return EIO;
+		}
+	}
+	__asm__ volatile ("dmb sy" ::: "memory");
+	{
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		ufs_wait_us += ns / 1000;
+	}
+	status = ufs_page->answer.status;
+	if (status != 0) {
+		printf("ufs: %s: blocks %llu..%llu: the loader's %s failed (status %llx)\n",
+		    ufs_page->part[part].name, lba, lba + count - 1,
+		    op == BLOCK_OP_READ ? "read" : op == BLOCK_OP_FLUSH ? "flush" : "write", (uint64_t)status);
+		ufs_errors++;
+		return EIO;
+	}
+	if (op != BLOCK_OP_READ) {
+		/* BLOCK_OP_WRITE: the loader has flushed, read the blocks back and found them the same */
+		if (op != BLOCK_OP_FLUSH) {
+			ufs_writes++;
+			ufs_write_bytes += bytes;
+		}
+		return 0;
+	}
+	started = mach_absolute_time();
+	/*
+	 * The buffer is mapped cacheable here (copying out of an uncached mapping went at 870 MB/s,
+	 * as slow as the storage itself). Core 0 cleans and invalidates it after every read, and this
+	 * side only ever fills it for a write of its own and cleans its lines then; whatever this
+	 * core may still hold of an earlier request -- a line brought in by a prefetch, say -- goes
+	 * before the copy.
+	 */
+	FlushPoC_DcacheRegion((vm_offset_t)ufs_buffer, (size_t)bytes);
+	memcpy(dst, ufs_buffer, (size_t)bytes);
+	{
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		ufs_copy_us += ns / 1000;
+	}
+	ufs_requests++;
+	ufs_bytes += bytes;
+	if (bytes <= 4096) {
+		ufs_small++;
+	} else if (bytes <= 65536) {
+		ufs_medium++;
+	} else {
+		ufs_large++;
+	}
+	return 0;
+}
+
+/* One of this driver's devices (block or character): a request to it costs tens of microseconds */
+bool
+hakios_ufs_dev(dev_t dev)
+{
+	return ufs_ready && ((ufs_bmajor >= 0 && major(dev) == ufs_bmajor) ||
+	       (ufs_cmajor >= 0 && major(dev) == ufs_cmajor));
+}
+
+/*
+ * Where the time of reading the storage went, so far: waiting for core 0's answer (of which
+ * the loader's own clock says how long ReadBlocks itself took) and copying out of its buffer.
+ */
+void
+hakios_ufs_report(const char *when)
+{
+	uint64_t loader_ns = 0;
+
+	if (!ufs_ready) {
+		return;
+	}
+	ufshc_report(when);
+	absolutetime_to_nanoseconds(ufs_page->answer.ticks, &loader_ns);
+	printf("ufs: %s: %llu requests (%llu of 4 KB or less, %llu to 64 KB, %llu more; %llu right after "
+	    "the one before), %llu errors, %llu bytes; waiting %llu ms, of it in ReadBlocks %llu ms; "
+	    "copying %llu ms\n", when, ufs_requests, ufs_small, ufs_medium, ufs_large, ufs_sequential,
+	    ufs_errors, ufs_bytes, ufs_wait_us / 1000, loader_ns / 1000000, ufs_copy_us / 1000);
+	if (ufs_write_part >= 0 || ufs_writes != 0 || ufs_write_refused != 0) {
+		printf("ufs: %s: %llu writes into darwin, %llu bytes, read back by the loader; %llu did not "
+		    "finish, %llu refused here\n", when, ufs_writes, ufs_write_bytes, ufs_write_errors,
+		    ufs_write_refused);
+	}
+}
+
+static uint64_t
+ufs_part_bytes(uint32_t part)
+{
+	return ufs_page->part[part].blocks * ufs_page->part[part].block_size;
+}
+
+/*
+ * Bytes [offset, offset + len) of partition part into dst, whatever their alignment, through the
+ * loader: the native blocks that cover them are read a buffer at a time and the wanted bytes
+ * copied out.
+ */
+static int
+ufs_read_mailbox(uint32_t part, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	uint64_t nbs = ufs_page->part[part].block_size, per = ufs_buffer_size / nbs;
+	static uint8_t *bounce;
+	int error = 0;
+
+	lck_mtx_lock(&ufs_lock);
+	/*
+	 * Allocated under the lock: two first readers at once would both allocate (one 4 MB leak),
+	 * and one could copy out of a buffer the other has just replaced and never filled.
+	 */
+	if (bounce == NULL) {
+		bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+		if (bounce == NULL) {
+			lck_mtx_unlock(&ufs_lock);
+			return ENOMEM;
+		}
+	}
+	if (ufshc_list_in()) {
+		/* this kernel's own transfer list is in the controller: UEFI's driver must not be asked to ring */
+		if (ufs_mailbox_refused++ < 4) {
+			printf("ufs: %s: not asked of the loader while this kernel's own transfer list is in\n",
+			    ufs_page->part[part].name);
+		}
+		lck_mtx_unlock(&ufs_lock);
+		return EIO;
+	}
+	while (len > 0 && error == 0) {
+		uint64_t first = offset / nbs, skip = offset % nbs;
+		uint64_t count = (skip + len + nbs - 1) / nbs, take;
+
+		if (count > per) {
+			count = per;
+		}
+		take = count * nbs - skip;
+		if (take > len) {
+			take = len;
+		}
+		if (skip == 0 && take == count * nbs) {
+			error = ufs_request(BLOCK_OP_READ, part, first, count, dst, NULL);   /* whole blocks: straight in */
+		} else {
+			error = ufs_request(BLOCK_OP_READ, part, first, count, bounce, NULL);
+			if (error == 0) {
+				memcpy(dst, bounce + skip, (size_t)take);
+			}
+		}
+		offset += take;
+		dst += take;
+		len -= take;
+	}
+	lck_mtx_unlock(&ufs_lock);
+	return error;
+}
+
+/* The same, through this kernel's own driver: the partition's unit, from where it begins there */
+static int
+ufs_read_native(uint32_t part, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	if (part >= ufs_parts || ufs_lun[part] == 0xff) {
+		return ENXIO;
+	}
+	return ufshc_read(ufs_lun[part], ufs_lun_offset[part] + offset, dst, len);
+}
+
+/* The switches of lists, with the loader's mailbox held: nothing is asked of UEFI meanwhile */
+static int
+ufs_native_in(bool prove)
+{
+	int error;
+
+	lck_mtx_lock(&ufs_lock);
+	/* (a loader that did not answer may still be inside UEFI's driver) */
+	error = ufs_dead ? EIO : ufshc_switch_in(prove);
+	lck_mtx_unlock(&ufs_lock);
+	return error;
+}
+
+static int
+ufs_native_out(const char *why)
+{
+	int error;
+
+	lck_mtx_lock(&ufs_lock);
+	error = ufshc_switch_out(why);
+	lck_mtx_unlock(&ufs_lock);
+	return error;
+}
+
+/* The way chosen (ufs_native=, kern.hakios.ufs_native); if this kernel's own fails, the loader's */
+static int
+ufs_read(uint32_t part, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	/*
+	 * No read leaves its partition on the native path either (the loader's path refuses it already):
+	 * a short partition would otherwise be read together with the one that follows it. Written
+	 * without a sum that can wrap.
+	 */
+	uint64_t part_size = ufs_part_bytes(part);
+
+	if (offset > part_size || len > part_size - offset) {
+		return EINVAL;
+	}
+	if (ufs_native_on && ufs_lun[part] != 0xff) {
+		int error = ufs_read_native(part, offset, dst, len);
+
+		if (error == 0) {
+			return 0;
+		}
+		if (ufs_write_busy) {
+			/* the list is out for a write of ours, not broken: this read goes the other way */
+			return ufs_read_mailbox(part, offset, dst, len);
+		}
+		if (ufs_native_on) {
+			ufs_native_on = false;
+			ufs_native_fallbacks++;
+			printf("ufs: %s: bytes %llu..%llu: this kernel's own read failed (%d); through the loader from now on\n",
+			    ufs_page->part[part].name, offset, offset + len - 1, error);
+		}
+		ufs_native_out("a read failed");
+	}
+	return ufs_read_mailbox(part, offset, dst, len);
+}
+
+/*
+ * Whole blocks [offset, offset + len) of the one partition that takes writes, from src, through
+ * the loader. This kernel's own driver never writes -- its whitelist of commands has no write in
+ * it -- so for the length of a write its transfer list goes out and UEFI's driver, which the
+ * loader calls, has the controller again; reads meanwhile go through the loader too (ufs_read),
+ * which is slower and right. Nothing of Darwin waits on this but the writer itself: the data volume
+ * is in memory (ramfs) and only its copy for the next boot is written here.
+ */
+static int
+ufs_write(uint32_t op, uint32_t part, uint64_t offset, const uint8_t *src, uint64_t len)
+{
+	uint64_t nbs, per;
+	int error = 0;
+
+	if (!ufs_ready || ufs_write_part < 0 || part != (uint32_t)ufs_write_part) {
+		ufs_write_refused++;
+		return EROFS;
+	}
+	nbs = ufs_page->part[part].block_size;
+	if (len == 0 || offset % nbs != 0 || len % nbs != 0) {
+		return EINVAL;          /* whole blocks only: nothing is read before a write */
+	}
+	if (offset / nbs < UFS_WRITE_FIRST || offset > ufs_part_bytes(part) ||
+	    len > ufs_part_bytes(part) - offset) {
+		/* the Darwin volume, the cryptexes, and anything past the partition's end: never */
+		ufs_write_refused++;
+		return EROFS;
+	}
+	per = ufs_buffer_size / nbs;
+	lck_mtx_lock(&ufs_write_mtx);
+	/*
+	 * The list goes out once, at the first write, and comes back when the device is closed: a
+	 * whole data volume is written a bufferful at a time, and switching the controller's list
+	 * for each of those would say so a hundred times over and buy nothing. ufs_native_on is
+	 * cleared first, so that a reader about to start goes the other way of its own accord; one
+	 * already inside this kernel's driver gets an error and is sent the other way by
+	 * ufs_write_busy.
+	 */
+	if (!ufs_write_out) {
+		ufs_write_was_native = ufs_native_on;
+		ufs_write_busy = true;
+		ufs_write_out = true;
+		if (ufs_write_was_native) {
+			ufs_native_on = false;
+			ufs_native_out("writing the data volume into darwin");
+		}
+	}
+	while (len > 0 && error == 0) {
+		uint64_t count = len / nbs;
+
+		if (count > per) {
+			count = per;
+		}
+		lck_mtx_lock(&ufs_lock);
+		if (ufshc_list_in()) {
+			/* it did not go out after all: UEFI's driver must not be asked to ring */
+			error = EIO;
+		} else {
+			error = ufs_request(op, part, offset / nbs, count, NULL, src);
+		}
+		lck_mtx_unlock(&ufs_lock);
+		offset += count * nbs;
+		src += count * nbs;
+		len -= count * nbs;
+	}
+	lck_mtx_unlock(&ufs_write_mtx);
+	if (error != 0) {
+		ufs_write_errors++;
+	}
+	return error;
+}
+
+/* The writing over: this kernel's own transfer list back in, and reads through it again. */
+static void
+ufs_write_restore(void)
+{
+	lck_mtx_lock(&ufs_write_mtx);
+	if (ufs_write_out) {
+		if (ufs_write_was_native && ufs_native_in(false) == 0) {
+			ufs_native_on = true;
+		}
+		ufs_write_busy = false;
+		ufs_write_out = false;
+	}
+	lck_mtx_unlock(&ufs_write_mtx);
+}
+
+/* Dedicated native capture, independent of the loader mailbox/return path.
+ * No writable device node is created. The exact known userdata geometry,
+ * LUN/GPT mapping and an existing journal signature are checked first. */
+extern size_t loader_log_snapshot(void *, size_t, uint32_t *);
+
+static int
+ufs_journal_chunk(uint64_t first, uint32_t block, const uint8_t *bytes, uint32_t length, uint8_t *verify)
+{
+	int error = ufshc_journal_write(first, first + block, bytes, length);
+	if (!error) error = ufshc_read(0, (first + block) * 4096, verify, length);
+	if (!error && memcmp(bytes, verify, length)) error = EIO;
+	return error;
+}
+
+static void
+ufs_journal_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t first = 0, sequence = 0;
+	unsigned matches = 0;
+	char identity[128] = { 0 };
+	uint8_t *body = NULL, *header = NULL, *verify = NULL;
+	delay_for_interval(5, NSEC_PER_SEC);
+	if (!ufs_ready || !ufs_native_on || !ufshc_available() ||
+	    !PE_parse_boot_argn("onyx_log_id", identity, sizeof(identity)) || !identity[0]) return;
+	identity[sizeof(identity) - 1] = 0;
+	for (uint32_t n = 0; n < ufs_parts; n++) {
+		if (strncmp((const char *)ufs_page->part[n].name, "userdata", 9)) continue;
+		if (!onyx_journal_geometry(ufs_page->part[n].block_size, ufs_page->part[n].blocks,
+		    ufs_page->part[n].start_lba, ufs_page->part[n].unit, ufs_page->part[n].lun,
+		    ufs_lun[n], ufs_lun_offset[n])) continue;
+		first = ufs_page->part[n].start_lba + ONYX_USERDATA_BYTES / 4096 - 512;
+		matches++;
+	}
+	if (matches != 1) {
+		printf("onyx-log: userdata geometry/mapping not uniquely verified; no writes\n");
+		return;
+	}
+	body = kalloc_data(ONYX_JOURNAL_BYTES - ONYX_JOURNAL_HEADER, Z_WAITOK | Z_ZERO);
+	header = kalloc_data(4096, Z_WAITOK | Z_ZERO);
+	verify = kalloc_data(65536, Z_WAITOK | Z_ZERO);
+	if (!body || !header || !verify) goto done;
+	if (ufshc_read(0, first * 4096, header, 4096) ||
+	    (memcmp(header, "== XNULOADER v3 ==", sizeof("== XNULOADER v3 ==") - 1) &&
+	     memcmp(header, "ONYXLOG1", 8))) {
+		printf("onyx-log: existing journal signature missing; no writes\n");
+		goto done;
+	}
+	for (;;) {
+		uint32_t flags = 0;
+		size_t length = loader_log_snapshot(body, ONYX_JOURNAL_BYTES - ONYX_JOURNAL_HEADER, &flags);
+		if (!length) { delay_for_interval(30, NSEC_PER_SEC); continue; }
+		uint32_t padded = ((uint32_t)length + 4095) & ~4095u;
+		bzero(body + length, padded - length);
+		int error = 0;
+		for (uint32_t at = 0; at < padded && !error; at += 65536) {
+			uint32_t chunk = padded - at < 65536 ? padded - at : 65536;
+			error = ufs_journal_chunk(first, 1 + at / 4096, body + at, chunk, verify);
+		}
+		/* Commit the header last. A torn/interrupted update is rejected by
+		 * the host's header and payload CRC checks, not mistaken for old data. */
+		if (!error) {
+			bzero(header, 4096);
+			memcpy(header, "ONYXLOG1", 8);
+			uint32_t version = 1, size = 4096, crc = onyx_journal_crc(body, length), state = 1 | flags << 1;
+			uint64_t payload = length, seq = ++sequence, ticks = mach_absolute_time();
+			memcpy(header + 8, &version, 4); memcpy(header + 12, &size, 4);
+			memcpy(header + 16, &seq, 8); memcpy(header + 24, &payload, 8);
+			memcpy(header + 32, &crc, 4); memcpy(header + 36, &state, 4);
+			memcpy(header + 40, identity, sizeof(identity)); memcpy(header + 176, &ticks, 8);
+			crc = onyx_journal_crc(header, 4096); memcpy(header + 168, &crc, 4);
+			error = ufs_journal_chunk(first, 0, header, 4096, verify);
+		}
+		printf("onyx-log: native snapshot %llu bytes %lu status %d (readback verified when zero)\n",
+		    sequence, (unsigned long)length, error);
+		if (error) break; /* do not keep ringing after a storage error */
+		delay_for_interval(sequence < 6 ? 10 : 30, NSEC_PER_SEC);
+	}
+done:
+	if (body) kfree_data(body, ONYX_JOURNAL_BYTES - ONYX_JOURNAL_HEADER);
+	if (header) kfree_data(header, 4096);
+	if (verify) kfree_data(verify, 65536);
+}
+
+static void
+ufs_journal_start(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("onyx_log_native", &enabled, sizeof(enabled)) || enabled != 1) return;
+	if (kernel_thread_start(ufs_journal_thread, NULL, &thread) == KERN_SUCCESS) thread_deallocate(thread);
+}
+
+/* ---- the data volume: darwin from UFS_WRITE_FIRST on ---- */
+
+static bool
+ufs_is_data(dev_t dev)
+{
+	return ufs_ready && ufs_write_part >= 0 && (uint32_t)minor(dev) == UFS_DATA_MINOR;
+}
+
+static uint64_t
+ufs_data_bytes(void)
+{
+	return ufs_part_bytes((uint32_t)ufs_write_part) - UFS_WRITE_FIRST * 4096;
+}
+
+/*
+ * How the data volume writes: only written, when the loader can (BLOCK_CAN_FAST), the flash's cache flushed when the
+ * file system asks (DKIOCSYNCHRONIZE: HFS Plus's journal, where the order of what reaches the flash matters); else as
+ * /dev/rufs_darwin writes, each flushed and read back, which is safe and slow.
+ */
+static uint32_t
+ufs_data_op(void)
+{
+	return (ufs_page->write_caps & BLOCK_CAN_FAST) ? BLOCK_OP_WRITE_FAST : BLOCK_OP_WRITE;
+}
+
+static int
+ufs_data_flush(void)
+{
+	int error;
+
+	if (ufs_data_op() != BLOCK_OP_WRITE_FAST) {
+		return 0;               /* every write was flushed already */
+	}
+	lck_mtx_lock(&ufs_write_mtx);
+	lck_mtx_lock(&ufs_lock);
+	/* one block in bounds, for the loader's checks; nothing of it is touched */
+	error = ufshc_list_in() ? EIO : ufs_request(BLOCK_OP_FLUSH, (uint32_t)ufs_write_part, UFS_WRITE_FIRST, 1, NULL, NULL);
+	lck_mtx_unlock(&ufs_lock);
+	lck_mtx_unlock(&ufs_write_mtx);
+	return error;
+}
+
+/*
+ * Bytes [offset, offset + len) of the data volume, read into p or written from it. A write that is not whole blocks
+ * of 4096 (the device may be counted in 512-byte ones) is made whole here: the blocks around it read, patched,
+ * written.
+ */
+static int
+ufs_data_io(bool write, uint64_t offset, uint8_t *p, uint64_t len)
+{
+	uint64_t base = UFS_WRITE_FIRST * 4096, size = ufs_data_bytes();
+	uint8_t *bounce;
+	int error = 0;
+
+	if (offset > size || len > size - offset) {
+		return EINVAL;
+	}
+	if (!write) {
+		return ufs_read((uint32_t)ufs_write_part, base + offset, p, len);
+	}
+	lck_mtx_lock(&ufs_data_mtx);
+	if (offset % 4096 == 0 && len % 4096 == 0) {
+		error = ufs_write(ufs_data_op(), (uint32_t)ufs_write_part, base + offset, p, len);
+		lck_mtx_unlock(&ufs_data_mtx);
+		return error;
+	}
+	bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	if (bounce == NULL) {
+		lck_mtx_unlock(&ufs_data_mtx);
+		return ENOMEM;
+	}
+	while (len > 0 && error == 0) {
+		uint64_t first = offset & ~4095ULL, skip = offset - first;
+		uint64_t span = (skip + len + 4095) & ~4095ULL, take;
+
+		if (span > ufs_buffer_size) {
+			span = ufs_buffer_size;
+		}
+		take = MIN(span - skip, len);
+		error = ufs_read((uint32_t)ufs_write_part, base + first, bounce, span);
+		if (error == 0) {
+			memcpy(bounce + skip, p, (size_t)take);
+			error = ufs_write(ufs_data_op(), (uint32_t)ufs_write_part, base + first, bounce, span);
+		}
+		offset += take;
+		p += take;
+		len -= take;
+	}
+	kfree_data(bounce, ufs_buffer_size);
+	lck_mtx_unlock(&ufs_data_mtx);
+	return error;
+}
+
+static void
+ufs_data_strategy(buf_t bp)
+{
+	uint64_t offset = (uint64_t)buf_blkno(bp) * ufs_data_bsize, len = buf_count(bp), size = ufs_data_bytes();
+	caddr_t mapped;
+	int error;
+
+	if (offset >= size) {
+		buf_seterror(bp, offset == size ? 0 : EINVAL);
+		buf_setresid(bp, buf_count(bp));
+		buf_biodone(bp);
+		return;
+	}
+	len = MIN(len, size - offset);
+	/* HFS Plus's cluster I/O hands over pages with no kernel address yet: buf_map() gives them one */
+	if ((error = buf_map(bp, &mapped)) == 0) {
+		error = ufs_data_io(!(buf_flags(bp) & B_READ), offset, (uint8_t *)mapped, len);
+		buf_unmap(bp);
+	}
+	buf_setresid(bp, (uint32_t)(buf_count(bp) - (error ? 0 : len)));
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+ufs_data_ioctl(u_long cmd, caddr_t data)
+{
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = ufs_data_bsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (*(uint32_t *)data < 512 || *(uint32_t *)data > 4096 ||
+		    (*(uint32_t *)data & (*(uint32_t *)data - 1)) != 0) {
+			return EINVAL;
+		}
+		ufs_data_bsize = *(uint32_t *)data;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*(uint32_t *)data = 4096;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = ufs_data_bytes() / ufs_data_bsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 1;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*(uint64_t *)data = ufs_buffer_size / ufs_data_bsize;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		return ufs_data_flush();
+	default:
+		return ENOTTY;
+	}
+}
+
+/* ---- the devices ---- */
+
+static int
+ufs_open(dev_t dev, int flags, __unused int devtype, __unused proc_t p)
+{
+	if (ufs_is_data(dev)) {
+		if (flags & FWRITE) {
+			lck_mtx_lock(&ufs_write_mtx);
+			if (ufs_var_busy_pid != 0) {
+				lck_mtx_unlock(&ufs_write_mtx);
+				return EBUSY;   /* a saver is writing the packed store into darwin */
+			}
+			ufs_data_used = true;
+			lck_mtx_unlock(&ufs_write_mtx);
+		}
+		return 0;
+	}
+	if (!ufs_ready || (uint32_t)minor(dev) >= ufs_parts || (ufs_page->part[minor(dev)].flags & BLOCK_PART_UNIT)) {
+		return ENXIO;
+	}
+	if (flags & FWRITE) {
+		return EROFS;           /* a block device of this driver never writes */
+	}
+	return 0;
+}
+
+/* The same, for the character devices: the one partition that takes writes may be opened for them. */
+static int
+ufs_copen(dev_t dev, int flags, int devtype, proc_t p)
+{
+	if ((flags & FWRITE) && ufs_write_part >= 0 && (uint32_t)minor(dev) == (uint32_t)ufs_write_part) {
+		if (ufs_data_used) {
+			return EBUSY;   /* the data volume is in darwin this run */
+		}
+		flags &= ~FWRITE;
+	}
+	return ufs_open(dev, flags, devtype, p);
+}
+
+static int
+ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static void ufs_write_restore(void);
+
+/* The last close of /dev/rufs_darwin ends the writing: this kernel's own transfer list goes back in. */
+static int
+ufs_cclose(dev_t dev, int flags, int devtype, proc_t p)
+{
+	if (ufs_write_part >= 0 && (uint32_t)minor(dev) == (uint32_t)ufs_write_part) {
+		ufs_write_restore();
+	}
+	return ufs_close(dev, flags, devtype, p);
+}
+
+static void
+ufs_strategy(buf_t bp)
+{
+	uint32_t part = (uint32_t)minor(buf_device(bp));
+	uint64_t offset, len, size;
+	int error;
+
+	if (ufs_is_data(buf_device(bp))) {
+		ufs_data_strategy(bp);
+		return;
+	}
+	if (!ufs_ready || part >= ufs_parts) {
+		buf_seterror(bp, ENXIO);
+		buf_biodone(bp);
+		return;
+	}
+	if (!(buf_flags(bp) & B_READ)) {
+		buf_seterror(bp, EROFS);         /* this device never writes */
+		buf_biodone(bp);
+		return;
+	}
+	size = ufs_part_bytes(part);
+	offset = (uint64_t)buf_blkno(bp) * ufs_bsize[part];
+	len = buf_count(bp);
+	if (offset >= size) {
+		buf_seterror(bp, offset == size ? 0 : EINVAL);
+		buf_setresid(bp, buf_count(bp));
+		buf_biodone(bp);
+		return;
+	}
+	if (offset + len > size) {
+		len = size - offset;
+	}
+	error = ufs_read(part, offset, (uint8_t *)buf_dataptr(bp), len);
+	buf_setresid(bp, (uint32_t)(buf_count(bp) - (error ? 0 : len)));
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+ufs_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int fflag, __unused proc_t p)
+{
+	uint32_t part = (uint32_t)minor(dev), native;
+
+	if (ufs_is_data(dev)) {
+		return ufs_data_ioctl(cmd, data);
+	}
+	if (!ufs_ready || part >= ufs_parts) {
+		return ENXIO;
+	}
+	native = ufs_page->part[part].block_size;
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = ufs_bsize[part];
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		/*
+		 * spec_open() sets the block size to 512 to count the device in 512-byte blocks and
+		 * then back, and treats a refusal as a broken device; reads are by byte here, so any
+		 * power of two from 512 to the native block size will do.
+		 */
+		if (*(uint32_t *)data < 512 || *(uint32_t *)data > native ||
+		    (*(uint32_t *)data & (*(uint32_t *)data - 1)) != 0) {
+			return EINVAL;
+		}
+		ufs_bsize[part] = *(uint32_t *)data;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*(uint32_t *)data = native;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = ufs_part_bytes(part) / ufs_bsize[part];
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 0;  /* the block device, which is what a filesystem would ask */
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*(uint64_t *)data = ufs_buffer_size / ufs_bsize[part];
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+ufs_psize(dev_t dev)
+{
+	uint32_t part = (uint32_t)minor(dev);
+
+	if (ufs_is_data(dev)) {
+		return (int)ufs_data_bsize;
+	}
+	return ufs_ready && part < ufs_parts ? (int)ufs_bsize[part] : -1;
+}
+
+/*
+ * A read of /dev/rufs_NAME: a bufferful at a time into memory of this kernel's and out to the
+ * reader with uiomove. Not physio, which hands the driver the reader's own address to copy to --
+ * and this kernel may not touch user memory itself (PAN): the copy has to go through uiomove.
+ * Nothing of this driver is held while it does, for a fault in the reader's memory can come back
+ * here as a read of the storage.
+ */
+static int
+ufs_cread(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t part = (uint32_t)minor(dev);
+	uint64_t size;
+	uint8_t *bounce;
+	int error = 0;
+
+	if (!ufs_ready || part >= ufs_parts) {
+		return ENXIO;
+	}
+	size = ufs_part_bytes(part);
+	if (uio_offset(uio) < 0) {
+		return EINVAL;
+	}
+	bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	if (bounce == NULL) {
+		return ENOMEM;
+	}
+	while (error == 0 && uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < size) {
+		uint64_t at = (uint64_t)uio_offset(uio), want = (uint64_t)uio_resid(uio);
+
+		if (want > ufs_buffer_size) {
+			want = ufs_buffer_size;
+		}
+		if (want > size - at) {
+			want = size - at;
+		}
+		error = ufs_read(part, at, bounce, want);
+		if (error == 0) {
+			error = uiomove((caddr_t)bounce, (int)want, uio);
+		}
+	}
+	kfree_data(bounce, ufs_buffer_size);
+	return error;
+}
+
+/*
+ * A write to /dev/rufs_darwin: whole blocks, out of user memory a bufferful at a time and into the
+ * partition. Nothing of this driver is held while user memory is touched -- a fault there can come
+ * back as a read of the storage -- so the bytes are taken first and written after.
+ */
+static int
+ufs_cwrite(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t part = (uint32_t)minor(dev);
+	uint64_t nbs;
+	uint8_t *bounce;
+	int error = 0;
+
+	if (!ufs_ready || part >= ufs_parts || ufs_write_part < 0 || part != (uint32_t)ufs_write_part) {
+		return EROFS;
+	}
+	if (ufs_var_busy_pid != proc_selfpid()) {
+		/* one writer of the store at a time, and it says so first (kern.hakios.var_busy) */
+		ufs_write_refused++;
+		return EPERM;
+	}
+	nbs = ufs_page->part[part].block_size;
+	if (uio_offset(uio) < 0 || (uint64_t)uio_offset(uio) % nbs != 0 || (uint64_t)uio_resid(uio) % nbs != 0) {
+		return EINVAL;
+	}
+	bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	if (bounce == NULL) {
+		return ENOMEM;
+	}
+	while (error == 0 && uio_resid(uio) > 0) {
+		user_ssize_t want = uio_resid(uio);
+		off_t at = uio_offset(uio);
+
+		if (want > (user_ssize_t)ufs_buffer_size) {
+			want = (user_ssize_t)ufs_buffer_size;
+		}
+		error = uiomove((caddr_t)bounce, (int)want, uio);
+		if (error == 0) {
+			error = ufs_write(BLOCK_OP_WRITE, part, (uint64_t)at, bounce, (uint64_t)want);
+			if (error != 0) {
+				/* these bytes did not go in: the write is to say so, not to count them */
+				uio_setoffset(uio, at);
+				uio_setresid(uio, uio_resid(uio) + want);
+			}
+		}
+	}
+	kfree_data(bounce, ufs_buffer_size);
+	return error;
+}
+
+static const struct bdevsw ufs_bdevsw = {
+	.d_open     = ufs_open,
+	.d_close    = ufs_close,
+	.d_strategy = ufs_strategy,
+	.d_ioctl    = ufs_ioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw ufs_cdevsw = {
+	.d_open       = ufs_copen,
+	.d_close      = ufs_cclose,
+	.d_read       = ufs_cread,
+	.d_write      = ufs_cwrite,
+	.d_ioctl      = ufs_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+/*
+ * The orderly end of a run, from osfmk/arm64/loader_return.c, in the thread that is about to hand
+ * control back: ask the saver for the data volume and wait for it, so that a run need not have
+ * been told to save. Bounded, and only when a saver registered -- the loader goes on feeding the
+ * watchdog for a minute past the run's own budget, and the host waits a hundred seconds past it,
+ * so twenty seconds here is well inside both. Nothing else of the way out has happened yet: the
+ * GPU, the DSPs and this kernel's transfer list are still as the run had them.
+ */
+void
+hakios_var_save_on_return(void)
+{
+	uint32_t ms = VAR_SAVE_MS;
+	uint64_t waited = 0;
+
+	if (!ufs_ready || ufs_write_part < 0 || ufs_var_save != VAR_SAVE_IDLE) {
+		return;
+	}
+	PE_parse_boot_argn("var_save_ms", &ms, sizeof(ms));
+	printf("var_store: the run is ending: the data volume is asked for\n");
+	ufs_var_save = VAR_SAVE_WANTED;
+	while (ufs_var_save != VAR_SAVE_DONE && waited < ms) {
+		IOSleep(20);
+		waited += 20;
+	}
+	if (ufs_var_save == VAR_SAVE_DONE) {
+		/* what it made of it is in its own lines: this only says it answered */
+		printf("var_store: the saver has finished after %llu ms\n", waited);
+	} else {
+		printf("var_store: the saver did not answer in %u ms: the store keeps what it had\n", ms);
+	}
+}
+
+/* ---- the check: the partitions there are images of, hashed as the loader hashes them ---- */
+
+static const struct {
+	const char *name;
+	uint64_t bytes;
+} ufs_references[] = {
+	{ "bluetooth", 503808 }, { "abl", 208896 }, { "aop", 208896 }, { "xbl", 3706880 },
+	{ "tz", 3710976 }, { "hyp", 3653632 }, { "dsp", 67108864 }, { "modem", 214265856 },
+};
+
+static bool
+ufs_is_reference(const char *name, const char *ref)
+{
+	size_t n = strlen(ref);
+
+	return strncmp(name, ref, n) == 0 &&
+	       (name[n] == 0 || (name[n] == '_' && (name[n + 1] == 'a' || name[n + 1] == 'b') && name[n + 2] == 0));
+}
+
+static void
+ufs_check(void *arg, __unused wait_result_t wr)
+{
+	uint8_t *chunk = kalloc_data(1 << 20, Z_WAITOK);
+
+	/*
+	 * Not at once: what the kernel prints in its first minute or so does not come back with the
+	 * log on the phone (the first line that does is from long after this driver has started), so
+	 * the check waits until it will be read -- unless it runs right at the start (ufs_check=2, then
+	 * back to the loader: the log is short).
+	 */
+	if (arg == NULL) {
+		IOSleep(40000);
+	}
+	printf("ufs: check: %u partitions of the phone's storage, read through %s\n", ufs_parts,
+	    ufs_native_on ? "this kernel's own UFS driver" : "the loader's page");
+	for (uint32_t part = 0; chunk != NULL && part < ufs_parts; part++) {
+		for (unsigned r = 0; r < sizeof(ufs_references) / sizeof(ufs_references[0]); r++) {
+			uint64_t h = 0xcbf29ce484222325ULL, done = 0, started = mach_absolute_time(), ns;
+			uint64_t bytes = ufs_references[r].bytes;
+			int error = 0;
+
+			if (!ufs_is_reference((const char *)ufs_page->part[part].name, ufs_references[r].name)) {
+				continue;
+			}
+			while (done < bytes && error == 0) {
+				uint64_t n = bytes - done < (1 << 20) ? bytes - done : (1 << 20);
+
+				error = ufs_read(part, done, chunk, n);
+				for (uint64_t i = 0; error == 0 && i < n; i++) {
+					h = (h ^ chunk[i]) * 0x100000001b3ULL;
+				}
+				done += n;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+			if (error) {
+				printf("ufs: check %s: read failed (%d)\n", ufs_page->part[part].name, error);
+			} else {
+				printf("ufs: check %s: fnv %llx over %llu bytes, %llu ms\n", ufs_page->part[part].name,
+				    h, bytes, ns / 1000000);
+			}
+		}
+	}
+	if (chunk != NULL) {
+		kfree_data(chunk, 1 << 20);
+	}
+	printf("ufs: check done: %llu requests, %llu errors, %llu bytes, %llu ms waiting\n",
+	    ufs_requests, ufs_errors, ufs_bytes, ufs_wait_us / 1000);
+}
+
+/*
+ * ufs_bench=1: what one request through the loader costs, by size. The partition "darwin" is
+ * read from the front, a different stretch for every size so that nothing the storage itself may
+ * have kept is read twice; for each size, MB/s and microseconds a request, split into the time
+ * core 0 spent in ReadBlocks (its clock in the page, read before and after), the rest of waiting
+ * for its answer (noticing the request, answering), and copying out of its buffer.
+ */
+static void
+ufs_bench(__unused void *arg, __unused wait_result_t wr)
+{
+	static const uint32_t sizes[] = { 4096, 16384, 65536, 262144, 1048576, 4194304 };
+	uint8_t *dst = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	uint32_t part = BLOCK_MAX_PARTS;
+	uint64_t base = 0;
+
+	for (uint32_t i = 0; i < ufs_parts; i++) {
+		if (strcmp((const char *)ufs_page->part[i].name, "darwin") == 0) {
+			part = i;
+		}
+	}
+	if (dst == NULL || part == BLOCK_MAX_PARTS) {
+		printf("ufs: bench: no partition darwin, or no memory\n");
+		return;
+	}
+	for (unsigned z = 0; z < sizeof(sizes) / sizeof(sizes[0]); z++) {
+		uint64_t total = sizes[z] <= 16384 ? (16ULL << 20) : (128ULL << 20), done = 0, n = 0;
+		uint64_t wait0 = ufs_wait_us, copy0 = ufs_copy_us, loader0 = ufs_page->answer.ticks;
+		uint64_t started = mach_absolute_time(), ns, loader_ns;
+		int error = 0;
+
+		while (done < total && error == 0) {
+			error = ufs_read(part, base + done, dst, sizes[z]);
+			done += sizes[z];
+			n++;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		absolutetime_to_nanoseconds(ufs_page->answer.ticks - loader0, &loader_ns);
+		printf("ufs: bench: %7u bytes a request: %4llu MB/s, %llu requests, %llu us each: "
+		    "ReadBlocks %llu, the rest of waiting %llu, copying %llu%s\n", sizes[z],
+		    ns ? (done * 1000ULL) / ns : 0, n, ns / 1000 / n, loader_ns / 1000 / n,
+		    (ufs_wait_us - wait0 - loader_ns / 1000) / n, (ufs_copy_us - copy0) / n,
+		    error ? " (an error)" : "");
+		base += total;
+	}
+	kfree_data(dst, ufs_buffer_size);
+	hakios_ufs_report("after the bench");
+}
+
+/* ---- this kernel's own driver: which unit is which, and whether it reads what the loader reads ---- */
+
+static uint64_t
+ufs_fnv(uint64_t h, const uint8_t *p, uint64_t n)
+{
+	for (uint64_t i = 0; i < n; i++) {
+		h = (h ^ p[i]) * 0x100000001b3ULL;
+	}
+	return h;
+}
+
+static uint32_t
+ufs_entry(const char *name)
+{
+	for (uint32_t i = 0; i < ufs_parts; i++) {
+		if (strcmp((const char *)ufs_page->part[i].name, name) == 0) {
+			return i;
+		}
+	}
+	return BLOCK_MAX_PARTS;
+}
+
+/*
+ * For the kernel's own drivers (the modem's file systems, drivers/modem/hakios.mpss.c): bytes
+ * [offset, offset + len) of the partition of that name (or of its _a or _b slot), and how big it
+ * is. ENXIO without the storage, ENOENT without the partition; nothing is written.
+ */
+int
+hakios_ufs_read_partition(const char *name, uint64_t offset, uint8_t *dst, uint64_t len, uint64_t *bytes)
+{
+	uint32_t part;
+
+	if (ufs_page == NULL) {
+		return ENXIO;
+	}
+	part = ufs_entry(name);
+	for (const char *slot = "_a"; part == BLOCK_MAX_PARTS && slot[0] != 0; slot = slot[1] == 'a' ? "_b" : "") {
+		char slotted[48];
+
+		snprintf(slotted, sizeof(slotted), "%s%s", name, slot);
+		part = ufs_entry(slotted);
+	}
+	if (part == BLOCK_MAX_PARTS) {
+		return ENOENT;
+	}
+	if (bytes != NULL) {
+		*bytes = ufs_part_bytes(part);
+	}
+	if (len == 0) {
+		return 0;
+	}
+	/* (written without a sum: offset + len wraps for an offset near 2^64) */
+	if (offset > ufs_part_bytes(part) || len > ufs_part_bytes(part) - offset) {
+		return EINVAL;
+	}
+	return ufs_read(part, offset, dst, len);
+}
+
+/*
+ * Which logical unit each unit the loader lists is (their device paths do not say): unit k is
+ * taken to be LUN k (ordinary logical units only: never a well-known one), and it is so only if
+ * block 1 (the GPT header, with the unit's own GUID in it) read through the loader
+ * is the same as block 1 of that LUN read here; no other LUN is read. The loader's reads are made
+ * first, with UEFI's list in; then this kernel's list goes in (with its proof) and stays in.
+ */
+static bool
+ufs_native_map(bool all_units, bool trust_lun0)
+{
+	uint8_t *mine = kalloc_data(4096, Z_WAITOK), *theirs = kalloc_data(BLOCK_MAX_UNITS * 4096, Z_WAITOK);
+	uint32_t units[BLOCK_MAX_UNITS], n = 0, mask = 0, darwin = ufs_entry("darwin");
+	bool good = mine != NULL && theirs != NULL;
+
+	memset(ufs_lun, 0xff, sizeof(ufs_lun));
+	for (uint32_t i = 0; good && i < ufs_parts && n < BLOCK_MAX_UNITS; i++) {
+		volatile struct loader_block_part *e = &ufs_page->part[i];
+
+		if ((e->flags & BLOCK_PART_UNIT) == 0 || e->unit >= 8) {
+			continue;
+		}
+		/* Explicit Onyx loaderless mode: only LUN 0, using the loader's
+		 * partition inventory without waiting for an unserved mailbox. */
+		if (trust_lun0) {
+			if (e->unit != 0 || e->block_size != 4096) continue;
+			units[n++] = i;
+			mask = 1;
+			ufs_native_luns = n;
+			break;
+		}
+		if (!all_units && (darwin == BLOCK_MAX_PARTS || ufs_page->part[darwin].unit != e->unit)) {
+			continue;
+		}
+		if (e->block_size != 4096 || ufs_read_mailbox(i, 4096, theirs + n * 4096, 4096) != 0 ||
+		    memcmp(theirs + n * 4096, "EFI PART", 8) != 0) {
+			printf("ufs: native: %s: no GPT header to know it by (block size %u)\n", e->name, e->block_size);
+			good = false;
+			break;
+		}
+		units[n++] = i;
+		mask |= 1u << e->unit;
+		ufs_native_luns = n;
+	}
+	if (good && (trust_lun0 || !all_units) && (n != 1 || ufs_page->part[units[0]].unit != 0)) {
+		printf("ufs: native: darwin is not on the first unit the loader lists: not LUN 0, not read here\n");
+		good = false;
+	}
+	ufshc_set_luns(mask);
+	if (good && ufs_native_in(true) != 0) {
+		good = false;
+	}
+	for (uint32_t k = 0; good && !trust_lun0 && k < n; k++) {
+		volatile struct loader_block_part *e = &ufs_page->part[units[k]];
+
+		if (ufshc_read((uint8_t)e->unit, 4096, mine, 4096) != 0 || memcmp(mine, theirs + k * 4096, 4096) != 0) {
+			printf("ufs: native: %s: LUN %u's block 1 is NOT what the loader reads as its block 1\n", e->name, e->unit);
+			good = false;
+		} else {
+			printf("ufs: native: %s is LUN %u: its GPT header read both ways is the same\n", e->name, e->unit);
+		}
+	}
+	if (!good) {
+		ufs_native_out("the units could not be told");
+		memset(ufs_lun, 0xff, sizeof(ufs_lun));
+	} else {
+		for (uint32_t i = 0; i < ufs_parts; i++) {
+			volatile struct loader_block_part *e = &ufs_page->part[i];
+
+			if (e->unit < 8 && (mask & (1u << e->unit)) && e->block_size == 4096) {
+				ufs_lun[i] = (uint8_t)e->unit;
+				ufs_lun_offset[i] = e->start_lba * 4096;
+			}
+		}
+	}
+	if (mine != NULL) {
+		kfree_data(mine, 4096);
+	}
+	if (theirs != NULL) {
+		kfree_data(theirs, BLOCK_MAX_UNITS * 4096);
+	}
+	return good;
+}
+
+/*
+ * ufs_native_check=1: what this kernel's own driver reads is what the loader reads, byte for
+ * byte. Spans are read a batch at a time, first all through the loader (UEFI's list in), then
+ * all here (this kernel's list in, proved), and compared.
+ */
+struct ufs_span {
+	uint32_t part;
+	uint64_t offset, len;
+};
+
+#define UFS_CMP_BUFFER      (32u << 20)
+
+static uint8_t *ufs_cmp_x, *ufs_cmp_y;
+static uint64_t ufs_cmp_mailbox_ns, ufs_cmp_native_ns, ufs_cmp_bytes, ufs_cmp_spans, ufs_cmp_differ, ufs_cmp_failed;
+
+static bool
+ufs_compare_batch(const struct ufs_span *s, uint32_t n, const char *what, bool quiet)
+{
+	uint64_t at, t, ns, hx = 0xcbf29ce484222325ULL, hy = hx, bytes = 0, mailbox_ns, native_ns;
+	bool same = true;
+	int e = 0;
+
+	t = mach_absolute_time();
+	if (ufs_native_out("the loader reads, to compare") != 0) {
+		e = EIO;
+	}
+	at = 0;
+	for (uint32_t i = 0; e == 0 && i < n; at += s[i].len, i++) {
+		e = ufs_read_mailbox(s[i].part, s[i].offset, ufs_cmp_x + at, s[i].len);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &mailbox_ns);
+	t = mach_absolute_time();
+	if (e == 0 && ufs_native_in(true) != 0) {
+		e = EIO;
+	}
+	at = 0;
+	for (uint32_t i = 0; e == 0 && i < n; at += s[i].len, i++) {
+		e = ufs_read_native(s[i].part, s[i].offset, ufs_cmp_y + at, s[i].len);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &native_ns);
+	ufs_cmp_mailbox_ns += mailbox_ns;
+	ufs_cmp_native_ns += native_ns;
+	if (e != 0) {
+		printf("ufs: native check: %s: a read failed (%d): STOP\n", what, e);
+		ufs_cmp_failed++;
+		return false;
+	}
+	at = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		if (memcmp(ufs_cmp_x + at, ufs_cmp_y + at, s[i].len) != 0) {
+			uint64_t k = 0;
+
+			while (ufs_cmp_x[at + k] == ufs_cmp_y[at + k]) {
+				k++;
+			}
+			printf("ufs: native check: %s %s: DIFFERENT at byte %llu (%02x through the loader, %02x here): STOP\n",
+			    ufs_page->part[s[i].part].name, what, s[i].offset + k, ufs_cmp_x[at + k], ufs_cmp_y[at + k]);
+			same = false;
+			ufs_cmp_differ++;
+		}
+		hx = ufs_fnv(hx, ufs_cmp_x + at, s[i].len);
+		hy = ufs_fnv(hy, ufs_cmp_y + at, s[i].len);
+		at += s[i].len;
+		bytes += s[i].len;
+	}
+	ufs_cmp_spans += n;
+	ufs_cmp_bytes += bytes;
+	if (!quiet || !same) {
+		printf("ufs: native check: %s %s: %u span(s), %llu bytes from %llu: %s (fnv %llx / %llx); loader %llu ms, here "
+		    "%llu ms (switches included)\n", ufs_page->part[s[0].part].name, what, n, bytes, s[0].offset,
+		    same ? "the same" : "NOT THE SAME", hx, hy, mailbox_ns / 1000000, native_ns / 1000000);
+	}
+	return same;
+}
+
+/* Bytes [offset, offset + len) of an entry, compared a buffer at a time; FNV-1a of the first ref bytes too */
+static bool
+ufs_compare(uint32_t part, uint64_t offset, uint64_t len, uint64_t ref, const char *what)
+{
+	uint64_t done = 0, href = 0xcbf29ce484222325ULL;
+	bool same = true;
+
+	while (done < len && same) {
+		struct ufs_span s = { part, offset + done, len - done < UFS_CMP_BUFFER ? len - done : UFS_CMP_BUFFER };
+
+		same = ufs_compare_batch(&s, 1, what, true);
+		if (same && ref > done) {
+			href = ufs_fnv(href, ufs_cmp_x, ref - done < s.len ? ref - done : s.len);
+		}
+		done += s.len;
+	}
+	printf("ufs: native check: %s %s: %llu bytes from %llu: %s%s", ufs_page->part[part].name, what, done, offset,
+	    same ? "the same" : "NOT THE SAME", ref ? "" : "\n");
+	if (ref) {
+		printf("; fnv %llx over the first %llu bytes (the loader's own survey hashes them)\n", href, ref);
+	}
+	return same;
+}
+
+static void
+ufs_native_check(void)
+{
+	uint8_t *h = kalloc_data(4096, Z_WAITOK);
+	uint32_t part;
+	bool going = true;
+
+	ufs_cmp_x = kalloc_data(UFS_CMP_BUFFER, Z_WAITOK);
+	ufs_cmp_y = kalloc_data(UFS_CMP_BUFFER, Z_WAITOK);
+	if (h == NULL || ufs_cmp_x == NULL || ufs_cmp_y == NULL) {
+		printf("ufs: native check: no memory\n");
+		/* what was got is given back: the early return would leak it */
+		if (h != NULL) {
+			kfree_data(h, 4096);
+		}
+		if (ufs_cmp_x != NULL) {
+			kfree_data(ufs_cmp_x, UFS_CMP_BUFFER);
+			ufs_cmp_x = NULL;
+		}
+		if (ufs_cmp_y != NULL) {
+			kfree_data(ufs_cmp_y, UFS_CMP_BUFFER);
+			ufs_cmp_y = NULL;
+		}
+		return;
+	}
+	printf("ufs: native check: through the loader and through this kernel's own driver, compared\n");
+	/* every unit's GPT: protective MBR, header, table; the backup table and header at the end */
+	for (uint32_t i = 0; going && i < ufs_parts; i++) {
+		volatile struct loader_block_part *e = &ufs_page->part[i];
+		uint64_t entries_lba, count, size, table, alt, alt_entries;
+		uint32_t want, got;
+
+		if ((e->flags & BLOCK_PART_UNIT) == 0 || ufs_lun[i] == 0xff) {
+			continue;
+		}
+		if (ufs_native_out("the loader reads, to compare") != 0 || ufs_read_mailbox(i, 4096, h, 4096) != 0) {
+			going = false;
+			break;
+		}
+		entries_lba = *(uint64_t *)(h + 72);
+		count = *(uint32_t *)(h + 80);
+		size = *(uint32_t *)(h + 84);
+		alt = *(uint64_t *)(h + 32);
+		table = (count * size + 4095) / 4096;
+		want = *(uint32_t *)(h + 16);
+		*(uint32_t *)(h + 16) = 0;
+		/* the header size comes from the flash: crc32 over more than the 4096 bytes read would run off the buffer */
+		if (*(uint32_t *)(h + 12) >= 92 && *(uint32_t *)(h + 12) <= 4096) {
+			got = crc32(0, h, *(uint32_t *)(h + 12));
+		} else {
+			got = ~want;                    /* (reported as WRONG below) */
+		}
+		printf("ufs: native check: %s (LUN %u): GPT header crc %s (%x), table at block %llu, %llu entries of %llu bytes, "
+		    "backup header at block %llu\n", e->name, ufs_lun[i], got == want ? "right" : "WRONG", got, entries_lba, count,
+		    size, alt);
+		going = ufs_compare(i, 0, (entries_lba + table) * 4096, 0, "GPT (MBR, header, table)");
+		if (!going || alt >= e->blocks || ufs_native_out("the loader reads, to compare") != 0 ||
+		    ufs_read_mailbox(i, alt * 4096, h, 4096) != 0 || memcmp(h, "EFI PART", 8) != 0 ||
+		    (alt_entries = *(uint64_t *)(h + 72)) > alt) {
+			printf("ufs: native check: %s: no backup GPT header at block %llu: STOP\n", e->name, alt);
+			going = false;
+			break;
+		}
+		going = ufs_compare(i, alt_entries * 4096, (alt + 1 - alt_entries) * 4096, 0, "backup GPT (table, header)");
+	}
+	/* the partitions there are images of, whole */
+	for (part = 0; going && part < ufs_parts; part++) {
+		if ((ufs_page->part[part].flags & BLOCK_PART_UNIT) || ufs_lun[part] == 0xff) {
+			continue;
+		}
+		for (unsigned r = 0; going && r < sizeof(ufs_references) / sizeof(ufs_references[0]); r++) {
+			if (ufs_is_reference((const char *)ufs_page->part[part].name, ufs_references[r].name)) {
+				going = ufs_compare(part, 0, ufs_part_bytes(part), ufs_references[r].bytes, "whole");
+			}
+		}
+	}
+	/* super's geometry and metadata */
+	if (going && (part = ufs_entry("super")) < BLOCK_MAX_PARTS && ufs_lun[part] != 0xff) {
+		going = ufs_compare(part, 0, 8 << 20, 0, "first 8 MB (geometry, metadata)");
+	}
+	/* darwin: 32 spread megabytes, 256 scattered blocks, 32 pieces that begin and end inside a block */
+	if (going && (part = ufs_entry("darwin")) < BLOCK_MAX_PARTS && ufs_lun[part] != 0xff) {
+		struct ufs_span s[256];
+		uint64_t bytes = ufs_part_bytes(part), seed = 0x9e3779b97f4a7c15ULL, total = 0;
+
+		for (uint32_t k = 0; k < 32; k++) {
+			s[k] = (struct ufs_span){ part, (bytes - (1 << 20)) / 32 * k / 4096 * 4096, 1 << 20 };
+		}
+		going = ufs_compare_batch(s, 32, "spread megabytes", false);
+		for (uint32_t k = 0; k < 256; k++) {
+			seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+			s[k] = (struct ufs_span){ part, (seed >> 16) % (bytes / 4096) * 4096, 4096 };
+		}
+		going = going && ufs_compare_batch(s, 256, "scattered blocks", false);
+		for (uint32_t k = 0; k < 32; k++) {
+			seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+			s[k] = (struct ufs_span){ part, (seed >> 16) % (bytes - (2 << 20)), 1 + (seed >> 40) % (512 << 10) };
+			total += s[k].len;
+		}
+		going = going && ufs_compare_batch(s, 32, "unaligned pieces", false);
+	}
+	kfree_data(h, 4096);
+	printf("ufs: native check %s: %llu spans, %llu bytes, %llu NOT THE SAME, %llu failed reads; through the loader %llu ms, "
+	    "through this kernel's own driver %llu ms (list switches included)\n", going ? "done" : "STOPPED", ufs_cmp_spans,
+	    ufs_cmp_bytes, ufs_cmp_differ, ufs_cmp_failed, ufs_cmp_mailbox_ns / 1000000, ufs_cmp_native_ns / 1000000);
+	ufs_native_out("after the check");
+	ufshc_report("after the check");
+}
+
+/*
+ * ufs_native_bench=1 (with ufs_native=1): what the flash gives with N reads in flight -- N
+ * threads each reading at random places of darwin, a size at a time -- MB/s and microseconds a
+ * read, for 1, 2, 4, 8, 16 and 31 threads. Then back to the loader.
+ */
+struct ufs_nb {
+	uint32_t part, size, per_thread;
+	uint64_t span, seed;
+	volatile uint32_t left;
+	int error;
+};
+
+static void
+ufs_nb_thread(void *arg, __unused wait_result_t wr)
+{
+	struct ufs_nb *nb = arg;
+	uint8_t *buf = kalloc_data(nb->size, Z_WAITOK);
+	uint64_t seed = os_atomic_add(&nb->seed, 0x9e3779b97f4a7c15ULL, relaxed);
+
+	for (uint32_t i = 0; buf != NULL && i < nb->per_thread; i++) {
+		int e;
+
+		seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+		e = ufs_read_native(nb->part, (seed >> 20) % (nb->span / nb->size) * nb->size, buf, nb->size);
+		if (e != 0) {
+			nb->error = e;
+		}
+	}
+	if (buf != NULL) {
+		kfree_data(buf, nb->size);
+	}
+	lck_mtx_lock(&ufs_lock);
+	nb->left--;
+	wakeup(nb);
+	lck_mtx_unlock(&ufs_lock);
+}
+
+static void
+ufs_native_bench(void)
+{
+	static const uint32_t sizes[] = { 4096, 32768, 131072, 524288 };
+	static const uint32_t threads[] = { 1, 2, 4, 8, 16, 31 };
+	uint32_t part = ufs_entry("darwin");
+
+	if (part >= BLOCK_MAX_PARTS || ufs_lun[part] == 0xff) {
+		printf("ufs: native bench: no darwin\n");
+		return;
+	}
+	for (unsigned z = 0; z < sizeof(sizes) / sizeof(sizes[0]); z++) {
+		for (unsigned t = 0; t < sizeof(threads) / sizeof(threads[0]); t++) {
+			struct ufs_nb nb = {
+				.part = part, .size = sizes[z], .span = ufs_part_bytes(part),
+				.per_thread = (sizes[z] <= 32768 ? 8192 : 2048) / threads[t] + 1, .seed = 12345 + z * 100 + t,
+			};
+			uint64_t started = mach_absolute_time(), ns, bytes;
+
+			nb.left = threads[t];
+			for (uint32_t i = 0; i < threads[t]; i++) {
+				thread_t th;
+
+				if (kernel_thread_start(ufs_nb_thread, &nb, &th) == KERN_SUCCESS) {
+					thread_deallocate(th);
+				} else {
+					lck_mtx_lock(&ufs_lock);
+					nb.left--;
+					lck_mtx_unlock(&ufs_lock);
+				}
+			}
+			lck_mtx_lock(&ufs_lock);
+			while (nb.left > 0) {
+				msleep(&nb, &ufs_lock, PRIBIO, "ufsbench", NULL);
+			}
+			lck_mtx_unlock(&ufs_lock);
+			absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+			bytes = (uint64_t)nb.per_thread * threads[t] * sizes[z];
+			printf("ufs: native bench: %6u bytes, %2u in flight: %4llu MB/s, %6llu reads/s, %5llu us a read%s\n",
+			    sizes[z], threads[t], ns ? bytes * 1000 / ns : 0, ns ? (bytes / sizes[z]) * 1000000000ULL / ns : 0,
+			    ns / 1000 * threads[t] / (bytes / sizes[z]), nb.error ? " (ERRORS)" : "");
+		}
+	}
+	ufshc_report("after the bench");
+}
+
+/* kern.hakios.ufs_native: 1 while reads go through this kernel's own driver; 0 or 1 may be set */
+static int
+ufs_sysctl_native(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = ufs_native_on, error, changed = 0;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error != 0 || !changed) {
+		return error;
+	}
+	if (value != 0) {
+		if (!(ufs_native_mapped && ufshc_available()) || ufs_native_in(true) != 0) {
+			return ENXIO;
+		}
+		ufs_native_on = true;
+	} else {
+		ufs_native_on = false;
+		ufs_native_out("kern.hakios.ufs_native=0");
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern_hakios, OID_AUTO, ufs_native, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    ufs_sysctl_native, "I", "1: the phone's storage is read by this kernel's own UFS driver, 0: through the loader");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_fallbacks, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_native_fallbacks,
+    "times a read of this kernel's own UFS driver failed and the loader's was used instead");
+
+/* ---- bringing it up ---- */
+
+void
+hakios_ufs_init(void)
+{
+	uint64_t pa = 0, buffer_pa;
+	uint32_t check = 0, made = 0;
+	vm_offset_t base;
+
+	if (!PE_parse_boot_argn("ufs_shared_pa", &pa, sizeof(pa)) || pa == 0) {
+		return;                 /* the loader was not asked for ufs=2: there is nothing to read through */
+	}
+	base = ml_io_map_unmappable((vm_offset_t)(pa & ~(UFS_PAGE - 1)),
+	    ((pa & (UFS_PAGE - 1)) + sizeof(struct loader_block) + UFS_PAGE - 1) & ~(UFS_PAGE - 1), VM_WIMG_WCOMB);
+	ufs_page = (volatile struct loader_block *)(base + (pa & (UFS_PAGE - 1)));
+	if (ufs_page->magic != BLOCK_MAGIC || ufs_page->version != BLOCK_VERSION ||
+	    ufs_page->size != sizeof(struct loader_block) || ufs_page->parts > BLOCK_MAX_PARTS) {
+		printf("ufs: the loader's page at %llx is not one this kernel knows (magic %llx, version %u, size %u)\n",
+		    pa, ufs_page->magic, ufs_page->version, ufs_page->size);
+		return;
+	}
+	ufs_parts = ufs_page->parts;
+	ufs_buffer_size = ufs_page->buffer_size;
+	buffer_pa = ufs_page->buffer_pa;
+	ufs_buffer = (const uint8_t *)(ml_io_map_unmappable((vm_offset_t)(buffer_pa & ~(UFS_PAGE - 1)),
+	    ((buffer_pa & (UFS_PAGE - 1)) + ufs_buffer_size + UFS_PAGE - 1) & ~(UFS_PAGE - 1), VM_WIMG_DEFAULT) +
+	    (buffer_pa & (UFS_PAGE - 1)));
+	ufs_seq = ufs_page->answer.answered;      /* a loader that served an earlier kernel counts on from there */
+
+	ufs_bmajor = bdevsw_add(-1, &ufs_bdevsw);
+	ufs_cmajor = ufs_bmajor < 0 ? -1 : cdevsw_add_with_bdev(-1, &ufs_cdevsw, ufs_bmajor);
+	if (ufs_cmajor < 0) {
+		printf("ufs: no device numbers to be had\n");
+		return;
+	}
+	for (uint32_t i = 0; i < ufs_parts; i++) {
+		char name[48];
+
+		ufs_bsize[i] = ufs_page->part[i].block_size;
+		if (ufs_page->part[i].flags & BLOCK_PART_UNIT) {
+			continue;               /* the units are for this kernel's own driver to be checked against */
+		}
+		snprintf(name, sizeof(name), "ufs_%s", ufs_page->part[i].name);
+		if (devfs_make_node(makedev(ufs_bmajor, i), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "%s", name) == NULL) {
+			printf("ufs: no node for %s (the same name twice?)\n", name);
+			continue;
+		}
+		snprintf(name, sizeof(name), "rufs_%s", ufs_page->part[i].name);
+		(void)devfs_make_node(makedev(ufs_cmajor, i), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "%s", name);
+		made++;
+	}
+	ufs_ready = true;
+	printf("ufs: %u partitions of the phone's storage as /dev/ufs_NAME and /dev/rufs_NAME, read only, "
+	    "through the loader's page at %llx and its %u KB buffer\n", made, pa, ufs_buffer_size >> 10);
+
+	/*
+	 * ufs_write=1: /dev/rufs_darwin takes writes, past the Darwin volume and the cryptexes. darwin
+	 * has to be the partition the port was set up with, in everything the loader's table says of
+	 * it; the loader looks at its GUIDs besides, and refuses the same bounds of its own accord.
+	 */
+	check = 0;
+	if (PE_parse_boot_argn("ufs_write", &check, sizeof(check)) && check == 1) {
+		uint32_t offered = ufs_page->write_part_plus_one;
+
+		if (offered == 0 || offered > ufs_parts || ufs_page->write_first != UFS_WRITE_FIRST) {
+			printf("ufs: the loader offers no partition to write into (ufs_write=1 on its command "
+			    "line too, and a loader that knows about writes)\n");
+		}
+		for (uint32_t i = 0; offered != 0 && i < ufs_parts; i++) {
+			const char *why = NULL;
+
+			if (strncmp((const char *)ufs_page->part[i].name, "darwin", 7) != 0) {
+				continue;
+			}
+			if (i != offered - 1) {
+				why = "the loader offers another partition";
+			} else if (ufs_page->part[i].flags & BLOCK_PART_UNIT) {
+				why = "it is a whole logical unit, not the partition";
+			} else if (ufs_page->part[i].unit != 0) {
+				/* the first unit UEFI lists, which this kernel's own driver reads as LUN 0 and
+				 * has compared with the loader's reads; the device path this firmware gives
+				 * says no logical unit number at all, so part[].lun is 0xff for every unit */
+				why = "it is not on the first logical unit";
+			} else if (ufs_page->part[i].blocks < UFS_DARWIN_MIN) {
+				why = "it is smaller than the layout's 20 GiB";
+			} else if (ufs_page->part[i].block_size != 4096) {
+				why = "its blocks are not 4096 bytes";
+			}
+			if (why != NULL) {
+				printf("ufs: darwin: no write will be asked for: %s\n", why);
+				continue;
+			}
+			ufs_write_part = (int)i;
+		}
+		if (ufs_write_part >= 0) {
+			printf("ufs: /dev/rufs_darwin takes writes, whole blocks from %llu on (%llu MB of it); "
+			    "everything else of the storage is read only\n", UFS_WRITE_FIRST,
+			    (ufs_page->part[ufs_write_part].blocks - UFS_WRITE_FIRST) * 4096 >> 20);
+			if (devfs_make_node(makedev(ufs_bmajor, UFS_DATA_MINOR), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640,
+			    "ufs_darwin_data") != NULL) {
+				printf("ufs: /dev/ufs_darwin_data: the same %llu MB as a block device, for the data volume; "
+				    "%s\n", ufs_data_bytes() >> 20, ufs_data_op() == BLOCK_OP_WRITE_FAST ?
+				    "writes flushed when the file system asks" : "every write flushed and read back (an older loader)");
+			}
+		} else {
+			printf("ufs: nothing takes writes: darwin is not among the partitions\n");
+		}
+	}
+
+	/*
+	 * ufs_native=1: through this kernel's own driver instead, its own transfer list in the
+	 * controller for the run, if all is as expected; 2: only look; 3: a dry run -- the list in and
+	 * out again, and in once more for the end of the run to take out, no command sent.
+	 */
+	check = 0;
+	memset(ufs_lun, 0xff, sizeof(ufs_lun));
+	if (PE_parse_boot_argn("ufs_native", &check, sizeof(check)) && check != 0) {
+		struct ufshc_loader offer = {
+			.hc_pa = ufs_page->native.hc_pa, .area_pa = ufs_page->native.area_pa,
+			.area_size = ufs_page->native.area_size, .ucd_offset = ufs_page->native.ucd_offset,
+			.ucd_size = ufs_page->native.ucd_size, .slots = ufs_page->native.slots,
+			.uefi_lo = ufs_page->native.uefi_utrlba, .uefi_hi = ufs_page->native.uefi_utrlbau,
+			.take_back = &ufs_page->loader_native.take_back, .list_in = &ufs_page->kernel_native.list_in,
+			.switched_in = (uint32_t *)&ufs_page->kernel_native.switched_in,
+			.switched_out = (uint32_t *)&ufs_page->kernel_native.switched_out,
+			.cnr_at_switch = &ufs_page->kernel_native.cnr_at_switch,
+		};
+		uint32_t mode = check, compare = 0;
+
+		PE_parse_boot_argn("ufs_native_check", &compare, sizeof(compare));
+		if (!ufshc_probe(&offer, mode == 2)) {
+			if (mode != 2) {
+				printf("ufs: this kernel's own UFS driver is not used: through the loader\n");
+			}
+		} else if (mode == 3) {
+			printf("ufs: native: dry run: this kernel's list in and out, no command\n");
+			if (ufs_native_in(false) == 0) {
+				IOSleep(1000);
+				ufs_native_out("dry run");
+				IOSleep(500);
+				ufs_native_in(false);
+				printf("ufs: native: dry run: the list stays in for the end of the run\n");
+			}
+		} else if (ufs_native_map(true, mode == 4)) {
+			ufs_native_mapped = true;
+			if (compare != 0) {
+				/* right here, in bsd_init's thread, and then back to the loader */
+				ufs_native_check();
+				hakios_ufs_report("after the check");
+				loader_return();
+			}
+			ufs_native_on = true;
+			compare = 0;
+			if (PE_parse_boot_argn("ufs_native_bench", &compare, sizeof(compare)) && compare != 0) {
+				ufs_native_bench();
+				hakios_ufs_report("after the bench");
+				loader_return();
+			}
+			printf("ufs: the partitions (LUN 0-%u) are read by this kernel's own UFS driver, its list in the "
+			    "controller (kern.hakios.ufs_native=0: through the loader)\n", ufs_native_luns - 1);
+			ufs_journal_start();
+		} else {
+			printf("ufs: this kernel's own UFS driver is not used: through the loader\n");
+		}
+	}
+
+	if (PE_parse_boot_argn("ufs_bench", &check, sizeof(check)) && check != 0) {
+		/* right here, in bsd_init's thread, and then back to the loader: nothing else is wanted */
+		ufs_bench(NULL, THREAD_AWAKENED);
+		loader_return();
+	}
+	check = 0;
+	if (PE_parse_boot_argn("ufs_check", &check, sizeof(check)) && check == 2) {
+		/* right here, whichever way the partitions are read (ufs_native=), and back to the loader */
+		ufs_check((void *)1, THREAD_AWAKENED);
+		hakios_ufs_report("after the check");
+		loader_return();
+	}
+	if (check == 1) {
+		thread_t thread;
+
+		if (kernel_thread_start(ufs_check, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
diff --git a/bsd/dev/onyx_ufshc.c b/bsd/dev/onyx_ufshc.c
new file mode 100644
index 0000000..b3bb869
--- /dev/null
+++ b/bsd/dev/onyx_ufshc.c
@@ -0,0 +1,1400 @@
+/*
+ * The phone's UFS host controller, driven from this kernel -- read only, next to UEFI's driver.
+ *
+ * Reading the storage through the loader (hakios.ufs.c) is one request at a time: Qualcomm's
+ * UFSDxe reads synchronously on core 0, and its transfer request list has room for one request
+ * only (UTRLBA points at a single descriptor, with UFSDxe's command descriptor right behind it,
+ * where slots 8.. would be). The controller takes 32 at once. So for the length of a run this
+ * kernel puts a list of its own into the controller: with nothing in flight, the list is stopped
+ * (UTRLRSR 0), UTRLBA/UTRLBAU are pointed at the new one, the list is started again; at the end
+ * (hakios_ufs_quiesce, from loader_return), what is in flight is waited for, the list stopped,
+ * UEFI's address written back, the list started. The list and its command descriptors are in
+ * memory the loader owns (it offers it in its page, with UEFI's address); the loader checks the
+ * address on every way back from a run and puts UEFI's back itself if the kernel did not
+ * (xnuloader/loader.c, hc_take_back), and neither reads nor writes for the kernel or for its log
+ * while another list is in. While this kernel's list is in, it asks the loader for nothing.
+ *
+ * Nothing else of the controller is changed: no reset, no link startup, no UIC command, no
+ * interrupt enable, aggregation, clock or power setting; the task management list is not
+ * touched; IS and UTRLCNR are only read. UTRLCLR is written only to clear this kernel's own
+ * slots when they do not finish at the end.
+ *
+ * Normal storage remains read only. An explicit onyx_log_native=1 additionally
+ * allows an internal, slot-bound FUA WRITE(10) into the pinned Onyx journal
+ * range (hakios.onyx_journal.h), after userdata inventory/signature checks and
+ * with readback verification. No write device or userspace ioctl is exposed.
+ * A command is made in a buffer of its own, and only one that passes
+ * ufshc_permitted() is ever written into a slot; what the slot then holds is read back and must
+ * be the same and pass again before the doorbell is rung. The whitelist checks three things of
+ * every command: the SCSI operation (READ(10)/READ(16), TEST UNIT READY, REQUEST SENSE, INQUIRY,
+ * READ CAPACITY(10/16), nothing else -- no query, no task management, no NOP), the data
+ * direction in the request descriptor (from the device or none, never to it), and the command
+ * UPIU's flags (never W); and the logical unit: never a well-known one (REPORT LUNS, BOOT, RPMB,
+ * the device), and only those reads are allowed to go to now (ufshc_set_luns: LUN 0, where the
+ * Darwin volume is, unless a comparison with the loader's reads asks for more). A read's length in
+ * the CDB must be what the UPIU expects. It is tried at the probe on made-up commands that must
+ * pass or be refused. This file builds READ(10) and TEST UNIT READY only.
+ *
+ * Every slot of this list holds a whitelisted command at all times: TEST UNIT READY until it is
+ * used for a read. Slot 0 is kept for the proof that the controller does read this list: after
+ * every switch, before any read, slot 0's TEST UNIT READY is rung and must come back in this
+ * list (its status written here). Were the controller still reading UEFI's list, the doorbell
+ * would run UEFI's slot 0 instead -- so first UEFI's slot 0 must hold a read too (it does: the
+ * loader's last use of the storage before a run is reading back the log it wrote), and the
+ * proof costs nothing either way. Reads go in slots 1..31.
+ *
+ * The doorbell is rung only with interrupts off, after looking that this kernel's list is the
+ * one in the controller and running, that the slot is free, and that the loader is not taking
+ * the controller back (it says so in its page, then waits before it does).
+ *
+ * The list and the command descriptors are mapped here without caching (nothing of them is ever
+ * in a cache line of this kernel's to be written back over what the controller writes); the data
+ * buffers are this kernel's memory, cleaned and invalidated around every read.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <stdarg.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <vm/vm_kern_xnu.h>
+#include <arm/machine_routines.h>
+#include <arm/pmap.h>
+#include <arm/caches_internal.h>
+#include <vm/memory_types.h>
+#include "hakios.ufshc.h"
+#include "hakios.onyx_journal.h"
+
+extern void IOSleep(unsigned int milliseconds);
+
+#define UFSHC_PHYS          0x1d84000ULL        /* ufshc@1d84000, "ufs_mem", in the phone's Android device tree */
+#define UFSHC_SIZE          0x3000
+
+/* UFSHCI registers (JESD223). 0x38..0x48, the UIC error codes, clear when read: never read here. */
+#define UFSHC_CAP           0x00
+#define UFSHC_VER           0x08
+#define UFSHC_HCDDID        0x10
+#define UFSHC_HCPMID        0x14
+#define UFSHC_AHIT          0x18
+#define UFSHC_IS            0x20
+#define UFSHC_IE            0x24
+#define UFSHC_HCS           0x30
+#define UFSHC_HCE           0x34
+#define UFSHC_UTRIACR       0x4c
+#define UFSHC_UTRLBA        0x50
+#define UFSHC_UTRLBAU       0x54
+#define UFSHC_UTRLDBR       0x58
+#define UFSHC_UTRLCLR       0x5c
+#define UFSHC_UTRLRSR       0x60
+#define UFSHC_UTRLCNR       0x64
+#define UFSHC_UTMRLBA       0x70
+#define UFSHC_UTMRLBAU      0x74
+#define UFSHC_UTMRLDBR      0x78
+#define UFSHC_UTMRLRSR      0x80
+
+#define CAP_NUTRS(c)        (((c) & 0x1f) + 1)
+#define CAP_64AS            (1u << 24)
+#define HCS_DP              (1u << 0)
+#define HCS_UTRLRDY         (1u << 1)
+#define IS_FATAL            ((1u << 2) | (1u << 11) | (1u << 12) | (1u << 16) | (1u << 17))  /* UE, DFES, UTPES, HCFES, SBFES */
+
+/* the request descriptor's first word: command type, data direction */
+#define UTRD_CT_MASK        0xf0000000u
+#define UTRD_CT_UFS         (1u << 28)
+#define UTRD_DD_MASK        (3u << 25)
+#define UTRD_DD_NONE        (0u << 25)
+#define UTRD_DD_OUT         (1u << 25)          /* only the opt-in bounded Onyx journal writer */
+#define UTRD_DD_IN          (2u << 25)
+#define OCS_SUCCESS         0x0
+#define OCS_INVALID         0xf
+
+#define UPIU_COMMAND        0x01
+#define UPIU_RESPONSE       0x21
+#define UPIU_FLAG_READ      0x40
+#define UPIU_FLAG_WRITE     0x20
+#define LUN_WELL_KNOWN      0x80
+
+#define SLOTS               32                  /* this kernel's list */
+#define SLOT_PROOF          0
+#define UCD_RESPONSE        512
+#define UCD_PRDT            1024
+#define PRD_MAX             (256u << 10)        /* the most one table entry describes */
+#define SLOT_BUFFER_DEFAULT (256u << 10)
+#define BLOCK               4096u               /* the logical block size of every unit here */
+
+#define TIMEOUT_MS          10000
+
+struct hc_cmd {
+	uint8_t upiu[32];
+	uint32_t dw0;
+};
+
+struct hc_slot {
+	uint32_t number;                        /* in this kernel's list */
+	volatile uint32_t *utrd;                /* its descriptor (the loader's memory, not cached here) */
+	volatile uint32_t *ucd;                 /* its command descriptor (likewise) */
+	uint64_t ucd_pa;
+	uint8_t *data;                          /* this kernel's memory, cached */
+	uint64_t data_pa;
+	bool journal_write;
+	uint32_t journal_lba, journal_blocks;
+};
+
+static vm_offset_t hc;                          /* the registers */
+static struct ufshc_loader hc_loader;
+static uint32_t hc_list_lo, hc_list_hi;         /* this kernel's list's address */
+static volatile uint32_t *hc_uefi_list;         /* UEFI's list, not cached here, only read */
+static uint64_t hc_uefi_map_pa, hc_uefi_map_size;
+static vm_offset_t hc_uefi_map_va;
+static struct hc_slot hc_slots[SLOTS];
+static uint32_t hc_nslots;                      /* slots 1..hc_nslots carry reads */
+static uint32_t hc_free;                        /* bit i: hc_slots[i] free */
+static uint32_t hc_slot_buffer = SLOT_BUFFER_DEFAULT;
+static uint32_t hc_lun_mask = 1;                /* the logical units reads may go to: LUN 0 */
+static bool hc_usable;
+static uint32_t hc_leave;                       /* ufs_native_leave=1 (a test): the list left in at the end, for the loader */
+static volatile bool hc_in, hc_closed, hc_dead;
+static uint32_t hc_is_in, hc_cnr_in;            /* IS and UTRLCNR when this kernel's list went in */
+static uint64_t hc_requests, hc_errors, hc_bytes, hc_wait_us, hc_refused, hc_most_in_flight, hc_proofs;
+static uint64_t hc_switch_in_count, hc_switch_out_count;
+static uint32_t hc_in_flight;
+/* where the time goes: doorbell reads while waiting, waits for a free slot, taking hc_lock, how many in flight */
+static uint64_t hc_polls, hc_slot_waits, hc_slot_wait_ticks, hc_lock_ticks, hc_flight_hist[6];
+
+static LCK_GRP_DECLARE(hc_lck_grp, "hakios-ufshc");
+static LCK_MTX_DECLARE(hc_lock, &hc_lck_grp);
+
+SYSCTL_DECL(_kern_hakios);
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_requests, CTLFLAG_RD | CTLFLAG_LOCKED, &hc_requests,
+    "reads this kernel's own UFS driver has had answered");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_errors, CTLFLAG_RD | CTLFLAG_LOCKED, &hc_errors,
+    "reads of this kernel's own UFS driver that failed");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &hc_bytes,
+    "bytes this kernel's own UFS driver has read");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_wait_us, CTLFLAG_RD | CTLFLAG_LOCKED, &hc_wait_us,
+    "microseconds spent waiting for the controller, summed over the reads");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_refused, CTLFLAG_RD | CTLFLAG_LOCKED, &hc_refused,
+    "commands the whitelist refused (there should never be one)");
+SYSCTL_QUAD(_kern_hakios, OID_AUTO, ufs_native_most_in_flight, CTLFLAG_RD | CTLFLAG_LOCKED, &hc_most_in_flight,
+    "the most reads this kernel's own UFS driver has had in flight at once");
+
+/*
+ * What this file says goes to the kernel's log, and the last lines are kept: the start of a long
+ * run's log does not come back to the loader (the buffer wraps), so they are said again at the
+ * end, into the loader's log directly (hakios_ufs_quiesce; printf is not for that moment).
+ */
+extern void loader_log_putc(char c);
+#define KEPT_LINES          64
+static char hc_kept[KEPT_LINES][208];
+static uint32_t hc_kept_count;
+
+static void
+hc_say(const char *format, ...) __printflike(1, 2);
+static void
+hc_say(const char *format, ...)
+{
+	char line[208];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	printf("%s", line);
+	strlcpy(hc_kept[hc_kept_count++ % KEPT_LINES], line, sizeof(hc_kept[0]));
+}
+
+/* the same, at the end: into the loader's log only */
+static void
+hc_say_late(const char *format, ...) __printflike(1, 2);
+static void
+hc_say_late(const char *format, ...)
+{
+	char line[208];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+}
+
+static inline uint32_t
+hc_read(uint32_t reg)
+{
+	return *(volatile uint32_t *)(hc + reg);
+}
+
+static inline void
+hc_write(uint32_t reg, uint32_t value)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(hc + reg) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint64_t
+hc_us_since(uint64_t start)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	return ns / 1000;
+}
+
+/* ---- the whitelist: the one check every command passes before it goes into a slot ---- */
+
+static const char *
+hc_refusal(const uint8_t *upiu, uint32_t dw0, uint32_t lun_mask, bool any_command_type)
+{
+	const uint8_t *cdb = upiu + 16;
+	uint32_t dd = dw0 & UTRD_DD_MASK;
+	uint64_t expected = (uint64_t)upiu[12] << 24 | (uint64_t)upiu[13] << 16 | (uint64_t)upiu[14] << 8 | upiu[15];
+	uint8_t lun = upiu[2];
+
+	/* the data direction: from the device, or none -- never to it */
+	if (dd == UTRD_DD_OUT || dd == UTRD_DD_MASK) {
+		return "data from host to device";
+	}
+	if (!any_command_type && (dw0 & UTRD_CT_MASK) != UTRD_CT_UFS) {
+		return "not a UFS storage command type";
+	}
+	/* a SCSI command, and its flags: never W */
+	if ((upiu[0] & 0x3f) != UPIU_COMMAND) {
+		return "not a SCSI command (a query, task management, NOP, ...)";
+	}
+	if (upiu[1] & UPIU_FLAG_WRITE) {
+		return "the W flag";
+	}
+	if (upiu[4] & 0x0f) {
+		return "not the SCSI command set";
+	}
+	/* a normal logical unit, and one reads may go to now */
+	if (lun & LUN_WELL_KNOWN) {
+		return "a well-known logical unit";
+	}
+	if (lun >= 8 || (lun_mask & (1u << lun)) == 0) {
+		return "a logical unit reads do not go to now";
+	}
+	/* the operation */
+	switch (cdb[0]) {
+	case 0x28:      /* READ(10) */
+	case 0x88: {    /* READ(16) */
+		uint64_t blocks = cdb[0] == 0x28 ? ((uint64_t)cdb[7] << 8 | cdb[8]) :
+		    ((uint64_t)cdb[10] << 24 | (uint64_t)cdb[11] << 16 | (uint64_t)cdb[12] << 8 | cdb[13]);
+
+		if (dd != UTRD_DD_IN || (upiu[1] & UPIU_FLAG_READ) == 0) {
+			return "a read without data from the device";
+		}
+		if (blocks == 0 || expected != blocks * BLOCK) {
+			return "a read whose length is not what the UPIU expects";
+		}
+		return NULL;
+	}
+	case 0x00:      /* TEST UNIT READY */
+		return dd == UTRD_DD_NONE && expected == 0 && (upiu[1] & UPIU_FLAG_READ) == 0 ? NULL :
+		       "TEST UNIT READY with data";
+	case 0x03:      /* REQUEST SENSE */
+	case 0x12:      /* INQUIRY */
+	case 0x25:      /* READ CAPACITY(10) */
+		return NULL;
+	case 0x9e:      /* SERVICE ACTION IN(16): READ CAPACITY(16) only */
+		return (cdb[1] & 0x1f) == 0x10 ? NULL : "a SERVICE ACTION IN other than READ CAPACITY(16)";
+	default:
+		return "a SCSI operation not on the list";
+	}
+}
+
+static bool
+ufshc_permitted(const struct hc_slot *slot, const uint8_t *upiu, uint32_t dw0)
+{
+	if (slot->journal_write)
+		return onyx_journal_command(upiu, dw0, slot->journal_lba, slot->journal_blocks, slot->number);
+	const char *why = hc_refusal(upiu, dw0, hc_lun_mask, false);
+
+	if (why == NULL) {
+		return true;
+	}
+	hc_refused++;
+	hc_say("ufs: native: REFUSED (%s): UPIU %02x %02x %02x %02x, CDB %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x, "
+	    "descriptor %08x; it goes into no slot\n", why, upiu[0], upiu[1], upiu[2], upiu[3], upiu[16], upiu[17], upiu[18],
+	    upiu[19], upiu[20], upiu[21], upiu[22], upiu[23], upiu[24], upiu[25], dw0);
+	return false;
+}
+
+static void
+hc_make_read(struct hc_cmd *c, uint8_t lun, uint8_t tag, uint32_t lba, uint32_t blocks)
+{
+	uint32_t bytes = blocks * BLOCK;
+
+	bzero(c, sizeof(*c));
+	c->upiu[0] = UPIU_COMMAND;
+	c->upiu[1] = UPIU_FLAG_READ;            /* simple task attribute */
+	c->upiu[2] = lun;
+	c->upiu[3] = tag;
+	c->upiu[12] = (uint8_t)(bytes >> 24);
+	c->upiu[13] = (uint8_t)(bytes >> 16);
+	c->upiu[14] = (uint8_t)(bytes >> 8);
+	c->upiu[15] = (uint8_t)bytes;
+	c->upiu[16] = 0x28;                     /* READ(10) */
+	c->upiu[18] = (uint8_t)(lba >> 24);
+	c->upiu[19] = (uint8_t)(lba >> 16);
+	c->upiu[20] = (uint8_t)(lba >> 8);
+	c->upiu[21] = (uint8_t)lba;
+	c->upiu[23] = (uint8_t)(blocks >> 8);
+	c->upiu[24] = (uint8_t)blocks;
+	c->dw0 = UTRD_CT_UFS | UTRD_DD_IN;      /* no interrupt, no inline encryption */
+}
+
+static void
+hc_make_tur(struct hc_cmd *c, uint8_t lun, uint8_t tag)
+{
+	bzero(c, sizeof(*c));
+	c->upiu[0] = UPIU_COMMAND;
+	c->upiu[2] = lun;
+	c->upiu[3] = tag;
+	c->upiu[16] = 0x00;                     /* TEST UNIT READY */
+	c->dw0 = UTRD_CT_UFS | UTRD_DD_NONE;
+}
+
+/*
+ * The whitelist tried on commands made up here and never sent: those that must be refused,
+ * and those that must pass. Pure bytes; nothing touches the controller.
+ */
+static bool
+hc_whitelist_selftest(void)
+{
+	static const struct {
+		uint8_t type, flags, lun, op, cdb1;
+		uint16_t blocks;                /* the CDB's length (READ(10)/(16)) */
+		uint32_t expected;              /* the UPIU's */
+		uint32_t dd;
+		bool pass;
+		const char *what;
+	} cases[] = {
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x28, 0, 1, 4096, UTRD_DD_IN, true, "READ(10) of LUN 0" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x88, 0, 1, 4096, UTRD_DD_IN, true, "READ(16) of LUN 0" },
+		{ UPIU_COMMAND, 0, 0, 0x00, 0, 0, 0, UTRD_DD_NONE, true, "TEST UNIT READY of LUN 0" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x25, 0, 0, 8, UTRD_DD_IN, true, "READ CAPACITY(10)" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0x2a, 0, 1, 4096, UTRD_DD_OUT, false, "WRITE(10)" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0x8a, 0, 1, 4096, UTRD_DD_OUT, false, "WRITE(16)" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x2a, 0, 1, 4096, UTRD_DD_IN, false, "WRITE(10) dressed as a read" },
+		{ UPIU_COMMAND, 0, 0, 0x2a, 0, 0, 0, UTRD_DD_NONE, false, "WRITE(10) with no data" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0x42, 0, 0, 24, UTRD_DD_OUT, false, "UNMAP" },
+		{ UPIU_COMMAND, 0, 0, 0x42, 0, 0, 0, UTRD_DD_NONE, false, "UNMAP with no data" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x28, 0, 1, 4096, UTRD_DD_OUT, false, "READ(10) with data host to device" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x28, 0, 1, 4096, UTRD_DD_MASK, false, "READ(10) with direction 3" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ | UPIU_FLAG_WRITE, 0, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) with the W flag" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) with only the W flag" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x28, 0, 1, 8192, UTRD_DD_IN, false, "READ(10) of a length other than expected" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0xc4, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) of the RPMB unit" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0xb0, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) of the BOOT unit" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0xd0, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) of the device unit" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0x81, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) of REPORT LUNS" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 3, 0x28, 0, 1, 4096, UTRD_DD_IN, false, "READ(10) of LUN 3 (not allowed now)" },
+		{ UPIU_COMMAND, 0, 0, 0x04, 0, 0, 0, UTRD_DD_NONE, false, "FORMAT UNIT" },
+		{ UPIU_COMMAND, 0, 0, 0x1b, 0, 0, 0, UTRD_DD_NONE, false, "START STOP UNIT" },
+		{ UPIU_COMMAND, 0, 0, 0x35, 0, 0, 0, UTRD_DD_NONE, false, "SYNCHRONIZE CACHE(10)" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0x3b, 0, 0, 4096, UTRD_DD_OUT, false, "WRITE BUFFER" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0xb5, 0, 0, 512, UTRD_DD_OUT, false, "SECURITY PROTOCOL OUT" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0xa2, 0, 0, 512, UTRD_DD_IN, false, "SECURITY PROTOCOL IN" },
+		{ UPIU_COMMAND, UPIU_FLAG_WRITE, 0, 0x15, 0, 0, 24, UTRD_DD_OUT, false, "MODE SELECT" },
+		{ UPIU_COMMAND, UPIU_FLAG_READ, 0, 0x9e, 0x11, 0, 32, UTRD_DD_IN, false, "SERVICE ACTION IN 0x11" },
+		{ UPIU_COMMAND, 0, 0, 0x00, 0, 0, 0, UTRD_DD_IN, false, "TEST UNIT READY with data in" },
+		{ 0x16, 0, 0, 0, 0, 0, 0, UTRD_DD_NONE, false, "a QUERY REQUEST" },
+		{ 0x04, 0, 0, 0, 0, 0, 0, UTRD_DD_NONE, false, "TASK MANAGEMENT" },
+		{ 0x00, 0, 0, 0, 0, 0, 0, UTRD_DD_NONE, false, "NOP OUT" },
+	};
+	bool right = true;
+
+	for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+		uint8_t upiu[32] = { 0 };
+		bool passed;
+
+		upiu[0] = cases[i].type;
+		upiu[1] = cases[i].flags;
+		upiu[2] = cases[i].lun;
+		upiu[12] = (uint8_t)(cases[i].expected >> 24);
+		upiu[13] = (uint8_t)(cases[i].expected >> 16);
+		upiu[14] = (uint8_t)(cases[i].expected >> 8);
+		upiu[15] = (uint8_t)cases[i].expected;
+		upiu[16] = cases[i].op;
+		upiu[17] = cases[i].cdb1;
+		if (cases[i].op == 0x88) {
+			upiu[16 + 12] = (uint8_t)(cases[i].blocks >> 8);
+			upiu[16 + 13] = (uint8_t)cases[i].blocks;
+		} else {
+			upiu[16 + 7] = (uint8_t)(cases[i].blocks >> 8);
+			upiu[16 + 8] = (uint8_t)cases[i].blocks;
+		}
+		passed = hc_refusal(upiu, UTRD_CT_UFS | cases[i].dd, 1u << 0, false) == NULL;
+		if (passed != cases[i].pass) {
+			hc_say("ufs: native: the whitelist %s %s\n", passed ? "LETS THROUGH" : "refuses", cases[i].what);
+			right = false;
+		}
+	}
+	/* and what this file makes */
+	{
+		struct hc_cmd c;
+
+		hc_make_read(&c, 0, 1, 12345, 64);
+		right &= hc_refusal(c.upiu, c.dw0, 1u << 0, false) == NULL;
+		hc_make_read(&c, 2, 1, 12345, 64);
+		right &= hc_refusal(c.upiu, c.dw0, 1u << 0, false) != NULL;
+		hc_make_tur(&c, 0, 0);
+		right &= hc_refusal(c.upiu, c.dw0, 1u << 0, false) == NULL;
+	}
+	hc_say("ufs: native: whitelist tried on %u commands made up and never sent -- READ(10/16), TEST UNIT READY, READ "
+	    "CAPACITY of LUN 0 pass; WRITE(10/16), UNMAP, a READ with data host to device, a READ with the W flag, the "
+	    "RPMB/BOOT/device/REPORT LUNS units, LUN 3, FORMAT, START STOP, SYNCHRONIZE CACHE, WRITE BUFFER, SECURITY "
+	    "PROTOCOL, MODE SELECT, query, task management, NOP refused: %s\n",
+	    (unsigned)(sizeof(cases) / sizeof(cases[0])) + 3, right ? "as it should" : "WRONG");
+	return right;
+}
+
+/* ---- one command in one slot ---- */
+
+static void
+hc_put(volatile uint32_t *to, const void *from, uint32_t bytes)
+{
+	for (uint32_t i = 0; i < bytes / 4; i++) {
+		uint32_t w;
+
+		memcpy(&w, (const uint8_t *)from + 4 * i, 4);
+		to[i] = w;
+	}
+}
+
+/*
+ * Into the slot: the command UPIU, an empty response, the PRD table for bytes of the slot's
+ * buffer, the descriptor -- only a command the whitelist passes, and only if what the slot then
+ * holds is the same and passes again.
+ */
+static int
+hc_place(struct hc_slot *s, const struct hc_cmd *c, uint32_t bytes)
+{
+	uint32_t n = 0, back[8];
+
+	if (!ufshc_permitted(s, c->upiu, c->dw0)) {
+		return EPERM;
+	}
+	hc_put(s->ucd, c->upiu, sizeof(c->upiu));
+	for (uint32_t i = sizeof(c->upiu) / 4; i < UCD_PRDT / 4; i++) {
+		s->ucd[i] = 0;
+	}
+	for (uint32_t at = 0; at < bytes; at += PRD_MAX, n++) {
+		volatile uint32_t *prd = s->ucd + (UCD_PRDT + 16 * n) / 4;
+		uint64_t pa = s->data_pa + at;
+		uint32_t len = bytes - at < PRD_MAX ? bytes - at : PRD_MAX;
+
+		prd[0] = (uint32_t)pa;
+		prd[1] = (uint32_t)(pa >> 32);
+		prd[2] = 0;
+		prd[3] = len - 1;
+	}
+	s->utrd[0] = c->dw0;
+	s->utrd[1] = 0;
+	s->utrd[2] = OCS_INVALID;
+	s->utrd[3] = 0;
+	s->utrd[4] = (uint32_t)s->ucd_pa;
+	s->utrd[5] = (uint32_t)(s->ucd_pa >> 32);
+	s->utrd[6] = ((UCD_RESPONSE / 4) << 16) | (UCD_RESPONSE / 4);   /* response: offset, length in dwords */
+	s->utrd[7] = ((UCD_PRDT / 4) << 16) | n;                        /* PRD table: offset in dwords, entries */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 8; i++) {
+		back[i] = s->ucd[i];
+	}
+	if (memcmp(back, c->upiu, sizeof(back)) != 0 || s->utrd[0] != c->dw0 ||
+	    !ufshc_permitted(s, (const uint8_t *)back, s->utrd[0])) {
+		hc_say("ufs: native: slot %u does not hold what was put in it: not rung\n", s->number);
+		hc_refused++;
+		return EPERM;
+	}
+	return 0;
+}
+
+/* The doorbell: only while this kernel's list is the one in, running, and the loader not taking it back */
+static int
+hc_ring(struct hc_slot *s)
+{
+	uint32_t bit = 1u << s->number;
+	boolean_t istate;
+	bool ok;
+
+	lck_mtx_lock(&hc_lock);
+	istate = ml_set_interrupts_enabled(FALSE);
+	ok = hc_in && !hc_closed && !hc_dead && *hc_loader.take_back == 0 &&
+	    hc_read(UFSHC_UTRLBA) == hc_list_lo && hc_read(UFSHC_UTRLBAU) == hc_list_hi &&
+	    (hc_read(UFSHC_UTRLRSR) & 1) != 0 && (hc_read(UFSHC_UTRLDBR) & bit) == 0;
+	if (ok && s->journal_write) {
+		uint32_t command[8];
+		for (unsigned n = 0; n < 8; n++) command[n] = s->ucd[n];
+		ok = onyx_journal_command((const uint8_t *)command, s->utrd[0],
+		    s->journal_lba, s->journal_blocks, s->number);
+	}
+	if (ok) {
+		hc_write(UFSHC_UTRLDBR, bit);
+	}
+	ml_set_interrupts_enabled(istate);
+	lck_mtx_unlock(&hc_lock);
+	return ok ? 0 : ENXIO;
+}
+
+/*
+ * ufs_native_hang=N (a test of the loader's side): once N reads are done, the thread that has just
+ * rung a doorbell stops the kernel -- every processor spinning with interrupts off, this one
+ * included -- with reads in flight and this kernel's list in. The heartbeat stops, and the
+ * loader (or the watchdog) must take it from there.
+ */
+static uint32_t hc_hang_after;
+static volatile uint32_t hc_hanging;
+
+static void
+hc_spin_forever(__unused void *parm)
+{
+	(void)ml_set_interrupts_enabled(FALSE);
+	for (;;) {
+		__builtin_arm_yield();
+	}
+}
+
+static void
+hc_hang(uint32_t slot)
+{
+	static int parm;
+
+	/* (into the loader's log directly as well: a hung kernel's own log never comes back to it) */
+	hc_say_late("ufs: native: ufs_native_hang=%u: the kernel stops HERE, every processor spinning with interrupts "
+	    "off; slot %u just rung, doorbell %08x, %u reads in flight, this kernel's list in\n", hc_hang_after, slot,
+	    hc_read(UFSHC_UTRLDBR), hc_in_flight);
+	cpu_broadcast_xcall(NULL, TRUE, hc_spin_forever, &parm);
+}
+
+/* Nothing more is sent from here on; whoever waits for a slot is told. */
+static void
+hc_off(void)
+{
+	hc_dead = true;
+	lck_mtx_lock(&hc_lock);
+	wakeup(&hc_free);
+	/* those who sleep on a slot's answer look at hc_dead now, not after their own 1 s tick */
+	for (uint32_t i = 0; i < SLOTS; i++) {
+		wakeup(&hc_slots[i]);
+	}
+	lck_mtx_unlock(&hc_lock);
+}
+
+/*
+ * Waiting for the controller. Its interrupt stays off (UEFI's setting), so completions are seen
+ * by reading UTRLDBR. A waiter looks at its own bit for a short while (hc_spin_us: a small read
+ * is done by then), then sleeps; one poller thread looks for all who sleep and wakes each whose
+ * slot is done. So the processors are not all taken by threads spinning on the doorbell, which
+ * kept others -- one woken because the volume's lock came free, say -- from running.
+ */
+static volatile uint32_t hc_waiting;            /* slots whose waiters sleep (hc_lock) */
+static uint32_t hc_done;                        /* slots the poller has seen done, not yet collected (hc_lock) */
+static bool hc_poller_asleep;
+static uint32_t hc_spin_us = 40;                /* boot-arg ufs_native_spin */
+static uint64_t hc_sleeps, hc_poller_polls, hc_poller_rounds;
+
+static void
+hc_poller(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		uint32_t waiting, db, done;
+
+		lck_mtx_lock(&hc_lock);
+		while (hc_waiting == 0) {
+			hc_poller_asleep = true;
+			msleep((void *)&hc_waiting, &hc_lock, PRIBIO, "ufshc-poll", NULL);
+		}
+		hc_poller_asleep = false;
+		waiting = hc_waiting;
+		lck_mtx_unlock(&hc_lock);
+		hc_poller_rounds++;
+		/* until one of them is done, or another waiter comes */
+		while (((db = hc_read(UFSHC_UTRLDBR)) & waiting) == waiting && hc_waiting == waiting) {
+			hc_poller_polls++;
+			__builtin_arm_yield();
+		}
+		done = waiting & ~db;
+		if (done != 0) {
+			lck_mtx_lock(&hc_lock);
+			hc_done |= done;
+			hc_waiting &= ~done;
+			for (uint32_t m = done; m != 0; m &= m - 1) {
+				wakeup(&hc_slots[__builtin_ctz(m)]);
+			}
+			lck_mtx_unlock(&hc_lock);
+		}
+	}
+}
+
+/* Until the controller is done with the slot's command; then whether it went well. */
+static int
+hc_complete(struct hc_slot *s, const char *what, bool tur)
+{
+	uint64_t started = mach_absolute_time(), us;
+	volatile const uint8_t *r = (volatile const uint8_t *)s->ucd + UCD_RESPONSE;
+	uint32_t ocs, bit = 1u << s->number;
+
+	uint64_t polls = 1;
+
+	while ((hc_read(UFSHC_UTRLDBR) & bit) && hc_us_since(started) < hc_spin_us) {
+		polls++;
+		__builtin_arm_yield();
+	}
+	if (hc_read(UFSHC_UTRLDBR) & bit) {
+		struct timespec second = { 1, 0 };
+
+		lck_mtx_lock(&hc_lock);
+		hc_sleeps++;
+		hc_waiting |= bit;
+		if (hc_poller_asleep) {
+			wakeup((void *)&hc_waiting);
+		}
+		while ((hc_done & bit) == 0) {
+			/*
+			 * The path went off while this one waited (another slot of the same read timed out):
+			 * do not wait out a fresh 10 s per slot (31 slots would hold the read for 310 s).
+			 * A slot whose doorbell bit is already clear did finish, so it is read as done.
+			 */
+			if (hc_dead) {
+				hc_waiting &= ~bit;
+				if ((hc_read(UFSHC_UTRLDBR) & bit) == 0) {
+					break;
+				}
+				lck_mtx_unlock(&hc_lock);
+				hc_say("ufs: native: slot %u (%s) not waited for: this path is already off\n", s->number, what);
+				return ETIMEDOUT;
+			}
+			(void)msleep(s, &hc_lock, PRIBIO, "ufshc-io", &second);
+			us = hc_us_since(started);
+			if ((hc_done & bit) == 0 && us > TIMEOUT_MS * 1000ULL) {
+				hc_waiting &= ~bit;
+				lck_mtx_unlock(&hc_lock);
+				hc_say("ufs: native: slot %u (%s) not done in %u s (doorbell %08x, IS %08x, HCS %08x): "
+				    "this path is off from now on\n", s->number, what, TIMEOUT_MS / 1000, hc_read(UFSHC_UTRLDBR),
+				    hc_read(UFSHC_IS), hc_read(UFSHC_HCS));
+				hc_off();
+				return ETIMEDOUT;
+			}
+		}
+		hc_done &= ~bit;
+		lck_mtx_unlock(&hc_lock);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	os_atomic_add(&hc_polls, polls, relaxed);
+	if (!tur) {
+		os_atomic_add(&hc_wait_us, hc_us_since(started), relaxed);
+	}
+	ocs = s->utrd[2] & 0xff;
+	if (ocs != OCS_SUCCESS || (r[0] & 0x3f) != UPIU_RESPONSE || r[3] != s->number || r[6] != 0 ||
+	    (r[7] != 0 && !(tur && r[7] == 0x02))) {
+		/* sense data follows the 32 bytes of the header: its length (2), then the fixed format */
+		hc_say("ufs: native: slot %u (%s): OCS %x, response %02x tag %02x, response %02x status %02x, "
+		    "sense key %x asc %02x ascq %02x\n", s->number, what, ocs, r[0], r[3], r[6], r[7],
+		    r[34 + 2] & 0x0f, r[34 + 12], r[34 + 13]);
+		if (!tur) {
+			os_atomic_inc(&hc_errors, relaxed);
+		}
+		return EIO;
+	}
+	return 0;
+}
+
+static struct hc_slot *
+hc_take(bool wait)
+{
+	struct hc_slot *s = NULL;
+	uint64_t t0 = mach_absolute_time();
+
+	lck_mtx_lock(&hc_lock);
+	hc_lock_ticks += mach_absolute_time() - t0;
+	if (hc_free == 0 && wait && !hc_dead && hc_in) {
+		uint64_t w0 = mach_absolute_time();
+
+		hc_slot_waits++;
+		while (hc_free == 0 && wait && !hc_dead && hc_in) {
+			msleep(&hc_free, &hc_lock, PRIBIO, "ufshc", NULL);
+		}
+		hc_slot_wait_ticks += mach_absolute_time() - w0;
+	}
+	if (hc_free != 0 && hc_in && !hc_dead) {
+		uint32_t i = (uint32_t)__builtin_ctz(hc_free), f;
+
+		hc_free &= ~(1u << i);
+		s = &hc_slots[i];
+		s->journal_write = false;
+		f = ++hc_in_flight;
+		if (f > hc_most_in_flight) {
+			hc_most_in_flight = f;
+		}
+		hc_flight_hist[f <= 1 ? 0 : f <= 2 ? 1 : f <= 4 ? 2 : f <= 8 ? 3 : f <= 16 ? 4 : 5]++;
+	}
+	lck_mtx_unlock(&hc_lock);
+	return s;
+}
+
+static void
+hc_give(struct hc_slot *s)
+{
+	lck_mtx_lock(&hc_lock);
+	s->journal_write = false;
+	hc_free |= 1u << (s - hc_slots);
+	hc_in_flight--;
+	wakeup(&hc_free);
+	lck_mtx_unlock(&hc_lock);
+}
+
+/*
+ * Bytes [offset, offset + len) of logical unit lun into dst: the blocks that cover them, a slot's
+ * buffer at a time, with as many slots in flight at once as are free (at least one), the wanted
+ * bytes copied out of each as it is done.
+ */
+int
+ufshc_read(uint8_t lun, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	struct {
+		struct hc_slot *slot;
+		uint32_t lba, blocks, skip, take;
+		uint8_t *to;
+	} q[SLOTS];
+	uint32_t head = 0, tail = 0, per = hc_slot_buffer / BLOCK;
+	int error = 0;
+
+	if (!hc_usable || !hc_in || hc_dead || hc_closed) {
+		return ENXIO;
+	}
+	while ((len > 0 && error == 0) || head != tail) {
+		/* as many more reads as there are free slots (and one, waiting for it, if none is in flight) */
+		while (len > 0 && error == 0 && tail - head < SLOTS) {
+			uint64_t first = offset / BLOCK, skip = offset % BLOCK;
+			uint64_t blocks = (skip + len + BLOCK - 1) / BLOCK, take;
+			struct hc_slot *s = hc_take(head == tail);
+			struct hc_cmd c;
+			int e;
+
+			if (s == NULL) {
+				if (head == tail) {
+					error = ENXIO;                  /* the path went off while waiting */
+				}
+				break;
+			}
+			if (blocks > per) {
+				blocks = per;
+			}
+			if (first + blocks > 0xffffffffULL) {
+				hc_give(s);
+				error = EINVAL;
+				break;
+			}
+			take = blocks * BLOCK - skip;
+			if (take > len) {
+				take = len;
+			}
+			hc_make_read(&c, lun, (uint8_t)s->number, (uint32_t)first, (uint32_t)blocks);
+			/* nothing of the buffer is left in a cache to be written back over what the controller writes */
+			FlushPoC_DcacheRegion((vm_offset_t)s->data, (size_t)blocks * BLOCK);
+			e = hc_place(s, &c, (uint32_t)blocks * BLOCK);
+			if (e == 0) {
+				e = hc_ring(s);
+			}
+			if (e == 0 && hc_hang_after != 0 && hc_requests >= hc_hang_after &&
+			    os_atomic_cmpxchg(&hc_hanging, 0, 1, relaxed)) {
+				hc_hang(s->number);
+			}
+			if (e != 0) {
+				hc_give(s);
+				error = e;
+				break;
+			}
+			q[tail % SLOTS].slot = s;
+			q[tail % SLOTS].lba = (uint32_t)first;
+			q[tail % SLOTS].blocks = (uint32_t)blocks;
+			q[tail % SLOTS].skip = (uint32_t)skip;
+			q[tail % SLOTS].take = (uint32_t)take;
+			q[tail % SLOTS].to = dst;
+			tail++;
+			offset += take;
+			dst += take;
+			len -= take;
+		}
+		/* the oldest one done, copied out, its slot free again */
+		if (head != tail) {
+			typeof(q[0]) *e = &q[head % SLOTS];
+			char what[48];
+			int r;
+
+			snprintf(what, sizeof(what), "LUN %u, blocks %u..%u", lun, e->lba, e->lba + e->blocks - 1);
+			r = hc_complete(e->slot, what, false);
+			if (r == 0) {
+				FlushPoC_DcacheRegion((vm_offset_t)e->slot->data, (size_t)e->blocks * BLOCK);
+				os_atomic_inc(&hc_requests, relaxed);
+				os_atomic_add(&hc_bytes, (uint64_t)e->blocks * BLOCK, relaxed);
+				if (error == 0) {
+					memcpy(e->to, e->slot->data + e->skip, e->take);
+				}
+			} else if (error == 0) {
+				error = r;
+			}
+			if (r != ETIMEDOUT) {
+				hc_give(e->slot);                       /* (a slot that never came back is not used again) */
+			}
+			head++;
+		}
+	}
+	return error;
+}
+
+/* Only the diagnostic journal uses writes. The public block devices and
+ * ordinary read slots still reject every write. The caller supplies a range
+ * established from the exact Onyx userdata inventory; no userspace ioctl or
+ * general native-write API is exposed. Writes are FUA and sequential here. */
+int
+ufshc_journal_write(uint64_t first, uint64_t lba, const uint8_t *data, uint32_t bytes)
+{
+	int enabled = 0;
+	if (!PE_parse_boot_argn("onyx_log_native", &enabled, sizeof(enabled)) || enabled != 1)
+		return EROFS;
+	if (!data || !bytes || bytes % BLOCK || bytes > hc_slot_buffer ||
+	    !onyx_journal_span(first, lba, bytes / BLOCK)) return EINVAL;
+	if (!hc_usable || !hc_in || hc_dead || hc_closed || !(hc_lun_mask & 1)) return ENXIO;
+	struct hc_slot *slot = hc_take(false);
+	if (!slot) return EBUSY;
+	struct hc_cmd command;
+	uint32_t blocks = bytes / BLOCK;
+	hc_make_read(&command, 0, (uint8_t)slot->number, (uint32_t)lba, blocks);
+	command.upiu[1] = UPIU_FLAG_WRITE;
+	command.upiu[16] = 0x2a;
+	command.upiu[17] = 8; /* FUA: commit this command before reporting completion */
+	command.dw0 = UTRD_CT_UFS | UTRD_DD_OUT;
+	slot->journal_lba = (uint32_t)lba;
+	slot->journal_blocks = blocks;
+	slot->journal_write = true;
+	memcpy(slot->data, data, bytes);
+	FlushPoC_DcacheRegion((vm_offset_t)slot->data, bytes);
+	int error = hc_place(slot, &command, bytes);
+	if (!error) error = hc_ring(slot);
+	if (!error) error = hc_complete(slot, "Onyx diagnostic journal WRITE(10) FUA", false);
+	if (error != ETIMEDOUT) hc_give(slot);
+	return error;
+}
+
+/* ---- the proof, and the switches ---- */
+
+/* UEFI's slot 0 holds a read (what the controller would run were it to take no notice of this list) */
+static const char *
+hc_uefi_slot0(uint8_t *upiu, uint32_t *dw0)
+{
+	uint64_t ucd = (uint64_t)hc_uefi_list[5] << 32 | hc_uefi_list[4];
+	volatile const uint8_t *u;
+
+	*dw0 = hc_uefi_list[0];
+	if (ucd < hc_uefi_map_pa || ucd + 32 > hc_uefi_map_pa + hc_uefi_map_size) {
+		return "UEFI's command descriptor is not where it was";
+	}
+	u = (volatile const uint8_t *)(hc_uefi_map_va + (ucd - hc_uefi_map_pa));
+	for (int i = 0; i < 32; i++) {
+		upiu[i] = u[i];
+	}
+	return hc_refusal(upiu, *dw0, 0xff, true) == NULL ? NULL : "UEFI's slot 0 does not hold a read";
+}
+
+/* This kernel's slot 0: TEST UNIT READY rung, and its status must come back in this list */
+static int
+hc_prove(void)
+{
+	struct hc_slot *s = &hc_slots[SLOT_PROOF];
+	struct hc_cmd c;
+	uint32_t ocs;
+	int e;
+
+	hc_make_tur(&c, (uint8_t)__builtin_ctz(hc_lun_mask), SLOT_PROOF);
+	e = hc_place(s, &c, 0);
+	if (e == 0) {
+		e = hc_ring(s);
+	}
+	if (e == 0) {
+		e = hc_complete(s, "the proof's TEST UNIT READY", true);
+	}
+	ocs = s->utrd[2] & 0xff;
+	hc_proofs++;
+	if (e != 0 || ocs != OCS_SUCCESS) {
+		hc_say("ufs: native: proof FAILED (%d): this list's slot 0 has OCS %x after its doorbell -- the controller "
+		    "did not run it from this list\n", e, ocs);
+		return e != 0 ? e : EIO;
+	}
+	hc_say("ufs: native: proof: TEST UNIT READY in this list's slot 0 came back here (OCS 0, response %02x, status %02x)\n",
+	    ((volatile const uint8_t *)s->ucd)[UCD_RESPONSE + 6], ((volatile const uint8_t *)s->ucd)[UCD_RESPONSE + 7]);
+	return 0;
+}
+
+struct hc_put_back_result {
+	uint32_t db_before, db_after_clear, lo, hi, rsr, db, is, cnr, cnr_ours;
+	bool cleared, ok;
+};
+
+/*
+ * UEFI's list back into the controller: what is in flight waited for (1 s), cleared if it does
+ * not finish (every slot of this list is this kernel's), the list stopped, UEFI's address
+ * written, the list started, read back. Interrupts off, no locks, no printing (the quiesce).
+ */
+static void
+hc_put_back(struct hc_put_back_result *r)
+{
+	uint64_t t;
+
+	bzero(r, sizeof(*r));
+	for (t = mach_absolute_time(); (r->db_before = hc_read(UFSHC_UTRLDBR)) != 0 && hc_us_since(t) < 1000000;) {
+		__builtin_arm_yield();
+	}
+	if (r->db_before != 0 && hc_read(UFSHC_UTRLBA) == hc_list_lo && hc_read(UFSHC_UTRLBAU) == hc_list_hi) {
+		r->cleared = true;
+		hc_write(UFSHC_UTRLCLR, 0);
+		for (t = mach_absolute_time(); (r->db_after_clear = hc_read(UFSHC_UTRLDBR)) != 0 && hc_us_since(t) < 1000000;) {
+			__builtin_arm_yield();
+		}
+	}
+	/* the completion notifications this kernel's requests left: exactly those bits, written with ones */
+	r->cnr_ours = hc_read(UFSHC_UTRLCNR) & ~hc_cnr_in;
+	if (r->cnr_ours != 0) {
+		hc_write(UFSHC_UTRLCNR, r->cnr_ours);
+	}
+	hc_write(UFSHC_UTRLRSR, 0);
+	for (t = mach_absolute_time(); (hc_read(UFSHC_UTRLRSR) & 1) && hc_us_since(t) < 5000;) {
+		__builtin_arm_yield();
+	}
+	hc_write(UFSHC_UTRLBA, hc_loader.uefi_lo);
+	hc_write(UFSHC_UTRLBAU, hc_loader.uefi_hi);
+	hc_write(UFSHC_UTRLRSR, 1);
+	r->lo = hc_read(UFSHC_UTRLBA);
+	r->hi = hc_read(UFSHC_UTRLBAU);
+	r->rsr = hc_read(UFSHC_UTRLRSR);
+	r->db = hc_read(UFSHC_UTRLDBR);
+	r->is = hc_read(UFSHC_IS);
+	r->cnr = hc_read(UFSHC_UTRLCNR);
+	r->ok = r->lo == hc_loader.uefi_lo && r->hi == hc_loader.uefi_hi && (r->rsr & 1);
+	if (r->ok) {
+		*hc_loader.list_in = 0;
+		(*hc_loader.switched_out)++;
+		hc_switch_out_count++;
+	}
+}
+
+static void
+hc_put_back_print(const char *why, const struct hc_put_back_result *r, bool late)
+{
+	void (*say)(const char *, ...) = late ? hc_say_late : hc_say;
+
+	if (r->cleared) {
+		say("ufs: native: %s: doorbell %08x did not clear in 1 s: this kernel's slots cleared (UTRLCLR), doorbell "
+		    "then %08x\n", why, r->db_before, r->db_after_clear);
+	}
+	say("ufs: native: %s: transfer list %s UEFI's %08x:%08x (run %u, doorbell %08x; IS %08x, at the switch %08x; "
+	    "completion %08x after clearing this kernel's %08x, at the switch %08x%s)\n", why, r->ok ? "back to" :
+	    "NOT BACK TO", r->hi, r->lo, r->rsr, r->db, r->is, hc_is_in, r->cnr, r->cnr_ours, hc_cnr_in,
+	    r->cnr == hc_cnr_in ? ", as it was" : ", NOT AS IT WAS");
+}
+
+/*
+ * This kernel's list into the controller (the caller holds the loader's mailbox: nothing is asked
+ * of UEFI meanwhile). prove: then slot 0's TEST UNIT READY, before anything is read.
+ */
+int
+ufshc_switch_in(bool prove)
+{
+	uint32_t lo, hi, db, rsr, hcs, uefi_dw0 = 0;
+	uint8_t uefi_upiu[32] = { 0 };
+	const char *no = NULL;
+	struct hc_put_back_result undo;
+	boolean_t istate;
+	bool undone = false;
+
+	if (!hc_usable || hc_dead || hc_closed) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&hc_lock);
+	if (hc_in) {
+		lck_mtx_unlock(&hc_lock);
+		return 0;
+	}
+	istate = ml_set_interrupts_enabled(FALSE);
+	if (*hc_loader.take_back != 0) {
+		no = "the loader has taken the controller back";
+	} else {
+		no = hc_uefi_slot0(uefi_upiu, &uefi_dw0);
+	}
+	lo = hc_read(UFSHC_UTRLBA);
+	hi = hc_read(UFSHC_UTRLBAU);
+	db = hc_read(UFSHC_UTRLDBR);
+	rsr = hc_read(UFSHC_UTRLRSR);
+	hcs = hc_read(UFSHC_HCS);
+	if (no == NULL) {
+		if (lo != hc_loader.uefi_lo || hi != hc_loader.uefi_hi) {
+			no = "the controller's list is not UEFI's";
+		} else if (db != 0) {
+			no = "a request in flight";
+		} else if ((rsr & 1) == 0 || (hcs & HCS_UTRLRDY) == 0) {
+			no = "the list is not running, or not ready";
+		}
+	}
+	if (no == NULL) {
+		uint64_t t;
+
+		hc_is_in = hc_read(UFSHC_IS);
+		hc_cnr_in = hc_read(UFSHC_UTRLCNR);
+		hc_write(UFSHC_UTRLRSR, 0);
+		for (t = mach_absolute_time(); (hc_read(UFSHC_UTRLRSR) & 1) && hc_us_since(t) < 5000;) {
+			__builtin_arm_yield();
+		}
+		if (hc_read(UFSHC_UTRLRSR) & 1) {
+			no = "the list did not stop";
+			hc_write(UFSHC_UTRLRSR, 1);     /* (UEFI's list, running, as it was) */
+		} else {
+			hc_write(UFSHC_UTRLBA, hc_list_lo);
+			hc_write(UFSHC_UTRLBAU, hc_list_hi);
+			hc_write(UFSHC_UTRLRSR, 1);
+			lo = hc_read(UFSHC_UTRLBA);
+			hi = hc_read(UFSHC_UTRLBAU);
+			rsr = hc_read(UFSHC_UTRLRSR);
+			if (lo != hc_list_lo || hi != hc_list_hi || (rsr & 1) == 0) {
+				no = "the controller did not take this list";
+				hc_put_back(&undo);
+				undone = true;
+			} else {
+				hc_in = true;
+				*hc_loader.cnr_at_switch = hc_cnr_in;
+				*hc_loader.list_in = 1;
+				(*hc_loader.switched_in)++;
+				hc_switch_in_count++;
+			}
+		}
+	}
+	ml_set_interrupts_enabled(istate);
+	lck_mtx_unlock(&hc_lock);
+	if (undone) {
+		hc_put_back_print("undoing", &undo, false);
+	}
+	if (no != NULL) {
+		hc_say("ufs: native: this kernel's list not put in: %s (list %08x:%08x, doorbell %08x, run %08x, HCS %08x; UEFI's "
+		    "slot 0 %08x, CDB %02x)\n", no, hi, lo, db, rsr, hcs, uefi_dw0, uefi_upiu[16]);
+		return EIO;
+	}
+	hc_say("ufs: native: transfer list switched from UEFI's %08x:%08x to this kernel's %08x:%08x (doorbell 0, run %u; "
+	    "IS %08x, completion %08x; UEFI's slot 0 holds a read: %08x, CDB %02x)\n", hc_loader.uefi_hi,
+	    hc_loader.uefi_lo, hi, lo, rsr, hc_is_in, hc_cnr_in, uefi_dw0, uefi_upiu[16]);
+	if (prove) {
+		int e = hc_prove();
+
+		if (e != 0) {
+			ufshc_switch_out("after the failed proof");
+			hc_off();
+			return e;
+		}
+	}
+	return 0;
+}
+
+/* UEFI's list back (the caller holds the loader's mailbox) */
+int
+ufshc_switch_out(const char *why)
+{
+	struct hc_put_back_result r;
+	uint64_t started;
+	boolean_t istate;
+
+	lck_mtx_lock(&hc_lock);
+	if (!hc_in) {
+		lck_mtx_unlock(&hc_lock);
+		return 0;
+	}
+	hc_in = false;                          /* nothing more is rung */
+	wakeup(&hc_free);
+	lck_mtx_unlock(&hc_lock);
+	/* what is in flight finishes (whoever waits for it sees it done) */
+	for (started = mach_absolute_time(); hc_read(UFSHC_UTRLDBR) != 0 && hc_us_since(started) < 2000000;) {
+		IOSleep(1);
+	}
+	lck_mtx_lock(&hc_lock);
+	istate = ml_set_interrupts_enabled(FALSE);
+	hc_put_back(&r);
+	ml_set_interrupts_enabled(istate);
+	lck_mtx_unlock(&hc_lock);
+	hc_put_back_print(why, &r, false);
+	if (!r.ok) {
+		hc_off();
+		return EIO;
+	}
+	return 0;
+}
+
+bool
+ufshc_list_in(void)
+{
+	return hc_in;
+}
+
+bool
+ufshc_available(void)
+{
+	return hc_usable && !hc_dead && !hc_closed;
+}
+
+void
+ufshc_set_luns(uint32_t mask)
+{
+	hc_lun_mask = mask & 0xff;
+}
+
+static void
+hc_report(const char *when, bool late)
+{
+	(late ? hc_say_late : hc_say)("ufs: native: %s: %llu reads, %llu errors, %llu bytes, %llu ms waiting (summed over reads), at most %llu "
+	    "in flight, %llu refused, list in %llu times and out %llu times, %llu proofs%s\n", when, hc_requests, hc_errors,
+	    hc_bytes, hc_wait_us / 1000, hc_most_in_flight, hc_refused, hc_switch_in_count, hc_switch_out_count, hc_proofs,
+	    hc_dead ? "; THE PATH IS OFF" : "");
+	{
+		uint64_t wait_ns, lock_ns;
+
+		absolutetime_to_nanoseconds(hc_slot_wait_ticks, &wait_ns);
+		absolutetime_to_nanoseconds(hc_lock_ticks, &lock_ns);
+		(late ? hc_say_late : hc_say)("ufs: native: %s: %llu doorbell reads while waiting (%llu a read), %llu waits for a "
+		    "free slot (%llu ms), %llu ms taking the slots' lock; reads put in with 1 in flight %llu, 2 %llu, 3-4 %llu, "
+		    "5-8 %llu, 9-16 %llu, more %llu\n", when, hc_polls, hc_requests ? hc_polls / hc_requests : 0, hc_slot_waits,
+		    wait_ns / 1000000, lock_ns / 1000000, hc_flight_hist[0], hc_flight_hist[1], hc_flight_hist[2],
+		    hc_flight_hist[3], hc_flight_hist[4], hc_flight_hist[5]);
+		(late ? hc_say_late : hc_say)("ufs: native: %s: waiters spin %u us, then sleep: %llu slept; the poller %llu "
+		    "rounds, %llu doorbell reads\n", when, hc_spin_us, hc_sleeps, hc_poller_rounds, hc_poller_polls);
+	}
+}
+
+void
+ufshc_report(const char *when)
+{
+	if (hc_usable) {
+		hc_report(when, false);
+	}
+}
+
+/* ---- the probe ---- */
+
+/*
+ * What the controller looks like as UEFI left it, and whether this kernel may put a list of its
+ * own in (only == true: say so and do not use it).
+ */
+bool
+ufshc_probe(const struct ufshc_loader *loader, bool only)
+{
+	uint32_t cap, ver, hcs, hce, is, ie, iacr, ahit, base, baseu, db, rsr, cnr, tm_base, tm_baseu, tm_db, tm_rsr;
+	uint32_t uefi_dw0 = 0, slots = 31;
+	uint8_t uefi_upiu[32] = { 0 };
+	uint64_t uefi_pa;
+	const char *no = NULL;
+	vm_offset_t area;
+
+	if (!hc_whitelist_selftest()) {
+		return false;
+	}
+	hc_loader = *loader;
+	PE_parse_boot_argn("ufs_native_buffer", &hc_slot_buffer, sizeof(hc_slot_buffer));
+	if (hc_slot_buffer < BLOCK || hc_slot_buffer > (4u << 20) || hc_slot_buffer % BLOCK) {
+		hc_slot_buffer = SLOT_BUFFER_DEFAULT;
+	}
+	PE_parse_boot_argn("ufs_native_slots", &slots, sizeof(slots));
+	if (slots < 1 || slots > SLOTS - 1) {
+		slots = SLOTS - 1;
+	}
+	PE_parse_boot_argn("ufs_native_leave", &hc_leave, sizeof(hc_leave));
+	PE_parse_boot_argn("ufs_native_hang", &hc_hang_after, sizeof(hc_hang_after));
+	if (loader->hc_pa != UFSHC_PHYS || loader->area_pa == 0 || loader->slots != SLOTS || (loader->area_pa & 0x3ff) ||
+	    loader->ucd_size < UCD_PRDT + 16 * (hc_slot_buffer / PRD_MAX + 1) || (loader->ucd_offset & 0x7f) ||
+	    (loader->ucd_size & 0x7f) || loader->ucd_offset < SLOTS * 32 ||
+	    loader->area_size < loader->ucd_offset + SLOTS * loader->ucd_size) {
+		hc_say("ufs: native: not used: the loader offers no area for a list (or not one as expected: controller %llx, "
+		    "area %llx of %u, command descriptors at %u of %u)\n", loader->hc_pa, loader->area_pa, loader->area_size,
+		    loader->ucd_offset, loader->ucd_size);
+		return false;
+	}
+	if (pmap_valid_address(loader->area_pa) || pmap_valid_address(loader->area_pa + loader->area_size - 1)) {
+		hc_say("ufs: native: not used: the loader's area %llx is memory this kernel manages\n", loader->area_pa);
+		return false;
+	}
+	hc = ml_io_map(UFSHC_PHYS, UFSHC_SIZE);
+	cap = hc_read(UFSHC_CAP);
+	ver = hc_read(UFSHC_VER);
+	hcs = hc_read(UFSHC_HCS);
+	hce = hc_read(UFSHC_HCE);
+	is = hc_read(UFSHC_IS);
+	ie = hc_read(UFSHC_IE);
+	iacr = hc_read(UFSHC_UTRIACR);
+	ahit = hc_read(UFSHC_AHIT);
+	base = hc_read(UFSHC_UTRLBA);
+	baseu = hc_read(UFSHC_UTRLBAU);
+	db = hc_read(UFSHC_UTRLDBR);
+	rsr = hc_read(UFSHC_UTRLRSR);
+	cnr = hc_read(UFSHC_UTRLCNR);
+	tm_base = hc_read(UFSHC_UTMRLBA);
+	tm_baseu = hc_read(UFSHC_UTMRLBAU);
+	tm_db = hc_read(UFSHC_UTMRLDBR);
+	tm_rsr = hc_read(UFSHC_UTMRLRSR);
+	hc_say("ufs: native: controller at %llx: CAP %08x (%u slots, 64-bit %s), VER %08x, HCDDID %08x, HCPMID %08x\n",
+	    UFSHC_PHYS, cap, CAP_NUTRS(cap), (cap & CAP_64AS) ? "yes" : "no", ver, hc_read(UFSHC_HCDDID),
+	    hc_read(UFSHC_HCPMID));
+	hc_say("ufs: native: HCE %08x, HCS %08x, IS %08x, IE %08x, UTRIACR %08x, AHIT %08x\n", hce, hcs, is, ie, iacr, ahit);
+	hc_say("ufs: native: transfer list %08x:%08x (the loader's note of UEFI's: %08x:%08x), doorbell %08x, run %08x, "
+	    "completion %08x; task management list %08x:%08x, doorbell %08x, run %08x\n", baseu, base, loader->uefi_hi,
+	    loader->uefi_lo, db, rsr, cnr, tm_baseu, tm_base, tm_db, tm_rsr);
+	uefi_pa = (uint64_t)baseu << 32 | base;
+
+	if ((hce & 1) == 0) {
+		no = "the controller is not enabled";
+	} else if ((hcs & (HCS_DP | HCS_UTRLRDY)) != (HCS_DP | HCS_UTRLRDY)) {
+		no = "no device present or the transfer list not ready";
+	} else if ((rsr & 1) == 0) {
+		no = "the transfer list is not running";
+	/* Onyx's proven port uses this legacy transfer-list subset on UFSHCI
+	 * 4.0. Preserve the existing controller readiness and capability gates. */
+	} else if (ver < 0x200 || ver >= 0x500) {
+		no = "a controller version other than 2.x, 3.x, or 4.x";
+	} else if (CAP_NUTRS(cap) < SLOTS) {
+		no = "fewer than 32 slots";
+	} else if ((cap & CAP_64AS) == 0) {
+		no = "no 64-bit addressing";
+	} else if (is & IS_FATAL) {
+		no = "an error status";
+	} else if (base != loader->uefi_lo || baseu != loader->uefi_hi) {
+		no = "the transfer list is not the one the loader noted as UEFI's";
+	} else if (db != 0) {
+		no = "a request in flight";
+	} else if (pmap_valid_address(uefi_pa)) {
+		no = "UEFI's transfer list is in memory this kernel manages";
+	}
+	if (no == NULL) {
+		/* UEFI's list and command descriptor (the page they are in), not cached here, only read */
+		hc_uefi_map_pa = uefi_pa & ~(uint64_t)PAGE_MASK;
+		hc_uefi_map_size = PAGE_SIZE;
+		hc_uefi_map_va = ml_io_map_unmappable((vm_offset_t)hc_uefi_map_pa, PAGE_SIZE, VM_WIMG_WCOMB);
+		hc_uefi_list = (volatile uint32_t *)(hc_uefi_map_va + (uefi_pa - hc_uefi_map_pa));
+		hc_say("ufs: native: UEFI's slot 0: %08x %08x %08x %08x %08x %08x %08x %08x\n", hc_uefi_list[0], hc_uefi_list[1],
+		    hc_uefi_list[2], hc_uefi_list[3], hc_uefi_list[4], hc_uefi_list[5], hc_uefi_list[6], hc_uefi_list[7]);
+		no = hc_uefi_slot0(uefi_upiu, &uefi_dw0);
+		hc_say("ufs: native: UEFI's last command: UPIU %02x %02x %02x %02x, CDB %02x %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x %02x\n", uefi_upiu[0], uefi_upiu[1], uefi_upiu[2], uefi_upiu[3], uefi_upiu[16], uefi_upiu[17],
+		    uefi_upiu[18], uefi_upiu[19], uefi_upiu[20], uefi_upiu[21], uefi_upiu[22], uefi_upiu[23], uefi_upiu[24],
+		    uefi_upiu[25]);
+	}
+	if (no != NULL) {
+		hc_say("ufs: native: not used: %s; the storage is read through the loader\n", no);
+		return false;
+	}
+	if (only) {
+		hc_say("ufs: native: as expected; ufs_native=2 asks for no more than this look\n");
+		return false;
+	}
+
+	/* this kernel's list and command descriptors, in the loader's area; every slot TEST UNIT READY to begin with */
+	area = ml_io_map_unmappable((vm_offset_t)(loader->area_pa & ~(uint64_t)PAGE_MASK),
+	    (vm_size_t)round_page((loader->area_pa & PAGE_MASK) + loader->area_size), VM_WIMG_WCOMB) +
+	    (vm_offset_t)(loader->area_pa & PAGE_MASK);
+	hc_list_lo = (uint32_t)loader->area_pa;
+	hc_list_hi = (uint32_t)(loader->area_pa >> 32);
+	for (uint32_t i = 0; i < SLOTS; i++) {
+		struct hc_slot *s = &hc_slots[i];
+		struct hc_cmd c;
+
+		s->number = i;
+		s->utrd = (volatile uint32_t *)(area + 32 * i);
+		s->ucd = (volatile uint32_t *)(area + loader->ucd_offset + i * loader->ucd_size);
+		s->ucd_pa = loader->area_pa + loader->ucd_offset + i * loader->ucd_size;
+		if (i >= 1 && i <= slots) {
+			vm_offset_t data = 0;
+
+			if (kmem_alloc_contig(kernel_map, &data, round_page(hc_slot_buffer), PAGE_MASK, 0, 0,
+			    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+				hc_say("ufs: native: not used: no memory for the slots' buffers\n");
+				return false;
+			}
+			s->data = (uint8_t *)data;
+			s->data_pa = kvtophys(data);
+			FlushPoC_DcacheRegion(data, hc_slot_buffer);
+		}
+		hc_make_tur(&c, 0, (uint8_t)i);
+		if (hc_place(s, &c, 0) != 0) {
+			hc_say("ufs: native: not used: slot %u would not take its TEST UNIT READY\n", i);
+			return false;
+		}
+	}
+	PE_parse_boot_argn("ufs_native_spin", &hc_spin_us, sizeof(hc_spin_us));
+	if (hc_spin_us > 5000) {
+		hc_spin_us = 5000;
+	}
+	{
+		thread_t th;
+
+		if (kernel_thread_start(hc_poller, NULL, &th) != KERN_SUCCESS) {
+			hc_say("ufs: native: not used: no poller thread\n");
+			return false;
+		}
+		thread_deallocate(th);
+	}
+	hc_nslots = slots;
+	hc_free = (uint32_t)(((1ULL << (slots + 1)) - 1) & ~1ULL);       /* slots 1..n */
+	hc_usable = true;
+	hc_say("ufs: native: usable: a list of %u slots at %llx (the loader's), reads in %u of them, %u KB each (the logical units reads may go to are set by hakios.ufs.c)%s\n",
+	    SLOTS, loader->area_pa, slots, hc_slot_buffer >> 10, hc_leave ? "; ufs_native_leave=1: the list is left in "
+	    "at the end, for the loader to take back" : "");
+	return true;
+}
+
+/*
+ * Before the kernel gives the phone back to the loader (loader_return, the other processors
+ * already stopped): nothing more is sent, what is in flight is waited for, UEFI's list put back.
+ * No locks (a stopped processor may hold one).
+ */
+void
+hakios_ufs_quiesce(void)
+{
+	struct hc_put_back_result r;
+
+	if (hc_kept_count != 0) {
+		hc_say_late("ufs: native: what happened in this run, again:\n");
+		for (uint32_t i = hc_kept_count > KEPT_LINES ? hc_kept_count - KEPT_LINES : 0; i < hc_kept_count; i++) {
+			const char *line = hc_kept[i % KEPT_LINES];
+
+			hc_say_late("> %s%s", line, line[0] != 0 && line[strlen(line) - 1] == '\n' ? "" : "...\n");
+		}
+	}
+	if (!hc_usable) {
+		return;
+	}
+	hc_closed = true;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	hc_say_late("ufs: native: at the end: entered with doorbell %08x, %u reads of this kernel's in flight, its list %s\n",
+	    hc_read(UFSHC_UTRLDBR), hc_in_flight, hc_in ? "in" : "out");
+	if (!hc_in && hc_read(UFSHC_UTRLBA) == hc_loader.uefi_lo && hc_read(UFSHC_UTRLBAU) == hc_loader.uefi_hi &&
+	    (hc_read(UFSHC_UTRLRSR) & 1)) {
+		hc_say_late("ufs: native: at the end: UEFI's list is in (doorbell %08x)\n", hc_read(UFSHC_UTRLDBR));
+		hc_report("at the end", true);
+		return;
+	}
+	hc_in = false;
+	if (hc_leave) {
+		hc_say_late("ufs: native: at the end: this kernel's list LEFT IN for the loader to take back "
+		    "(ufs_native_leave=1; doorbell %08x)\n", hc_read(UFSHC_UTRLDBR));
+		hc_report("at the end", true);
+		return;
+	}
+	hc_put_back(&r);
+	hc_put_back_print("at the end", &r, true);
+	hc_report("at the end", true);
+}

@@ -0,0 +1,19 @@
+#include <assert.h>
+#include <stdio.h>
+#include "onyx_bootlog_ring.h"
+int main(void) {
+ static struct onyx_bootlog_ring r;
+ static unsigned char out[ONYX_BOOTLOG_CAPACITY];
+ uint32_t flags=99;
+ assert(onyx_bootlog_copy(&r,out,sizeof out,&flags)==0 && flags==0);
+ onyx_bootlog_append(&r,0);onyx_bootlog_append(&r,255);
+ assert(onyx_bootlog_copy(&r,out,sizeof out,&flags)==2 && out[0]==0 && out[1]==255);
+ for(unsigned i=0;i<ONYX_BOOTLOG_CAPACITY+7;i++)onyx_bootlog_append(&r,(unsigned char)i);
+ assert(onyx_bootlog_copy(&r,out,sizeof out,&flags)==sizeof out && flags==2);
+ for(unsigned i=0;i<sizeof out;i++)assert(out[i]==(unsigned char)(i+7));
+ assert(onyx_bootlog_copy(&r,out,7,&flags)==7 && flags==6);
+ for(unsigned i=0;i<7;i++)assert(out[i]==(unsigned char)i);
+ assert(onyx_bootlog_copy(&r,NULL,0,&flags)==0 && flags==6);
+ assert(onyx_bootlog_copy(&r,NULL,7,&flags)==0);
+ puts("boot log: embedded NUL, chronological wrap, newest-tail truncation and flags passed");
+}
